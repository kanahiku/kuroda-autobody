# ─── Sanity — Astro site (required) ────────────────────────────────────────────
# Create a NEW Sanity project for this client (sanity.io/manage). Blog only. Leave empty to render the blog's empty state.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_TOKEN=          # Viewer (read-only) token

# ─── Sanity — Studio ────────────────────────────────────────────────────────────
# Add these in studio/.env (same values as above)
# SANITY_STUDIO_PROJECT_ID=
# SANITY_STUDIO_DATASET=production
# SANITY_STUDIO_HOSTNAME=kuroda-autobody

# ─── Contact form (public, baked into HTML) ────────────────────────────────────
# Posts to the shared Cloudflare Worker, which holds its own Resend key. (Only the careers form below needs one on Vercel.)
# Local: PUBLIC_FORM_ENDPOINT=http://localhost:8787/submit and `npm run forms:dev`
PUBLIC_FORM_ENDPOINT=https://massic-forms.kanahiku.workers.dev/submit
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
PUBLIC_SITE_SLUG=kuroda-autobody
SITE_NAME=Kuroda Autobody

# ─── Careers form (server-only — résumé uploads) ──────────────────────────────
# /careers/ posts to /api/careers/ (src/pages/api/careers.ts), which emails cori@ and info@ via Resend.
# The shared forms worker above cannot take file attachments, so these three live on Vercel instead.
RESEND_API_KEY=
RESEND_FROM=Kuroda Autobody <careers@kurodaautobody.com>   # must be on a domain verified in Resend
TURNSTILE_SECRET_KEY=      # secret of the Turnstile widget behind PUBLIC_TURNSTILE_SITE_KEY

# ─── Google Tag Manager + Search Console ───────────────────────────────────────
# These are not env vars. Put them in src/config/site.ts:
#   analytics.googleTagManagerId
#   analytics.googleSiteVerificationId

# ─── Site URL ──────────────────────────────────────────────────────────────────
# SITE_URL=https://example.com

# ─── ISR / Sanity publish → live (required in production) ─────────────────────
# These are NOT issued by Sanity or Vercel. Generate them (openssl rand -hex 32).
# Then paste the SAME values into:
#   Vercel → Project → Settings → Environment Variables
#   Sanity → Project → API → Webhooks → Authorization: Bearer <SANITY_REVALIDATE_SECRET>
ISR_BYPASS_TOKEN=
SANITY_REVALIDATE_SECRET=

# ─── Reviews (Google Places + Yelp Fusion) ─────────────────────────────────────
# Server-only. Do not prefix with PUBLIC_. Empty keys skip that source; View all still uses the URLs.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_REVIEWS_URL=
YELP_API_KEY=
YELP_BUSINESS_ID=
YELP_REVIEWS_URL=

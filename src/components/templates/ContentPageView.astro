---
/**
 * ContentPageView — the one template behind every copy-driven interior page
 * (/collision-repair/<service>/, /had-an-accident/<topic>/, …).
 *
 * Copy comes from a `ContentPage` object (src/data/contentPage.ts); this file only picks the
 * shared widget for each block. Nothing page-specific lives here or in the route files.
 *
 *   PageHero → blue band → sections[] → FAQs → related TagGrid → CTABanner (renders its own silver band)
 *
 * Surfaces alternate page / subtle down the page (a block can pin one with `surface`).
 * Hero buttons and the closing CTA's subtitle + buttons are the widgets' sitewide defaults.
 */
import Layout from '~/layouts/PageLayout.astro';
import GradientBand from '~/components/ui/GradientBand.astro';
import PageHero from '~/components/widgets/PageHero.astro';
import FeatureColumns from '~/components/widgets/FeatureColumns.astro';
import PhaseTable from '~/components/widgets/PhaseTable.astro';
import ProcessSteps from '~/components/widgets/ProcessSteps.astro';
import HeritageStory from '~/components/widgets/HeritageStory.astro';
import QuoteBand from '~/components/widgets/QuoteBand.astro';
import ReviewWall from '~/components/widgets/ReviewWall.astro';
import ActionBand from '~/components/widgets/ActionBand.astro';
import CredentialLogos from '~/components/widgets/CredentialLogos.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import TagGrid from '~/components/widgets/TagGrid.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import type { ContentPage, ContentSection } from '~/data/contentPage';
import { sitemapLabel } from '~/lib/sitemap';
import { getTestimonials } from '~/lib/content';

export interface Props {
  page: ContentPage;
}

const { page } = Astro.props;

const metadata = {
  title: page.seoTitle,
  ignoreTitleTemplate: true,
  description: page.metaDescription,
};

// `reviews` sections with `source: 'sanity'` pull the Studio's testimonials; the section's own
// `reviews` array is the fallback when Sanity has none.
const needsTestimonials = page.sections.some((s) => s.type === 'reviews' && s.source === 'sanity');
const testimonials = needsTestimonials ? await getTestimonials() : [];

const pageLabel = sitemapLabel(page.path);
const relatedItems = (page.related?.paths ?? []).map((path) => ({ label: sitemapLabel(path), href: path }));

// Body = authored sections, then FAQs, then the related grid. Surfaces alternate unless pinned.
type Block = { kind: 'section'; section: ContentSection } | { kind: 'faqs' } | { kind: 'related' };

const blocks: Block[] = [
  ...page.sections.map((section): Block => ({ kind: 'section', section })),
  ...(page.faqs ? [{ kind: 'faqs' } as Block] : []),
  ...(page.related ? [{ kind: 'related' } as Block] : []),
];

let previous: 'page' | 'subtle' = 'subtle';
const body = blocks.map((block) => {
  // The navy ActionBand has its own surface and does not advance the page/subtle rhythm.
  const ownSurface = block.kind === 'section' && block.section.type === 'action';
  const pinned = block.kind === 'section' && 'surface' in block.section ? block.section.surface : undefined;
  const surface = pinned ?? (previous === 'page' ? 'subtle' : 'page');
  if (!ownSurface) previous = surface;
  return { block, surface };
});
---

<Layout metadata={metadata}>
  <PageHero
    eyebrow={page.eyebrow}
    titleLead={page.hero.titleLead}
    titleAccent={page.hero.titleAccent}
    body={page.hero.body}
    photoLabel={page.hero.photoLabel ?? `${pageLabel} at Kuroda Autobody in Waipahu`}
  />

  <GradientBand variant="blue" />

  {
    body.map(({ block, surface }) => {
      if (block.kind === 'faqs') {
        const faqs = page.faqs;
        if (!faqs) return null;
        return (
          <FAQs
            surface={surface}
            eyebrow={faqs.eyebrow}
            title={faqs.titleLead}
            titleStrong={faqs.titleStrong}
            items={faqs.items?.map(({ cta, ...item }) => ({ ...item, callToAction: cta }))}
            groups={faqs.groups?.map((g) => ({
              title: g.title,
              items: g.items.map(({ cta, ...item }) => ({ ...item, callToAction: cta })),
            }))}
          />
        );
      }
      if (block.kind === 'related') {
        const related = page.related;
        if (!related) return null;
        return (
          <TagGrid
            surface={surface}
            columns={3}
            eyebrow={related.eyebrow}
            headingLead={related.headingLead}
            headingStrong={related.headingStrong}
            items={relatedItems}
          />
        );
      }
      const s = block.section;
      switch (s.type) {
        case 'features':
          return (
            <FeatureColumns
              surface={surface}
              eyebrow={s.eyebrow}
              headingLead={s.headingLead}
              headingStrong={s.headingStrong}
              lead={s.lead}
              columns={s.columns ?? 2}
              items={s.items}
              note={s.note}
              noteLinkText={s.noteLinkText}
              noteLinkHref={s.noteLinkHref}
            />
          );
        case 'table':
          return (
            <PhaseTable
              surface={surface}
              eyebrow={s.eyebrow}
              headingLead={s.headingLead}
              headingStrong={s.headingStrong}
              lead={s.lead}
              columns={s.columns}
              rows={s.rows}
            />
          );
        case 'steps':
          return (
            <ProcessSteps
              surface={surface}
              eyebrow={s.eyebrow}
              headingLead={s.headingLead}
              headingStrong={s.headingStrong}
              lead={s.lead}
              steps={s.steps}
            />
          );
        case 'story':
          return (
            <HeritageStory
              surface={surface}
              eyebrow={s.eyebrow ?? ''}
              headingLead={s.headingLead}
              headingAccent={s.headingAccent}
              paragraphs={s.paragraphs}
              quote={s.quote ?? ''}
              quoteAttribution={s.quoteAttribution}
              stats={s.stats ?? []}
              caption={s.caption ?? ''}
              isReversed={s.isReversed}
              photoLabel={s.photoLabel ?? `${pageLabel} at Kuroda Autobody`}
            />
          );
        case 'quote':
          return <QuoteBand surface={surface} eyebrow={s.eyebrow} quote={s.quote} attribution={s.attribution} />;
        case 'reviews':
          return (
            <ReviewWall
              surface={surface}
              eyebrow={s.eyebrow}
              headingLead={s.headingLead}
              headingStrong={s.headingStrong}
              reviews={s.source === 'sanity' && testimonials.length > 0 ? testimonials : s.reviews}
            />
          );
        case 'action':
          return (
            <ActionBand
              eyebrow={s.eyebrow}
              headingLead={s.headingLead}
              headingStrong={s.headingStrong}
              body={s.body}
              ctaText={s.ctaText}
              ctaHref={s.ctaHref}
            />
          );
        case 'credentials':
          return (
            <CredentialLogos
              surface={surface}
              eyebrow={s.eyebrow}
              headingLead={s.headingLead}
              headingStrong={s.headingStrong}
              paragraphs={s.paragraphs}
              credentials={s.credentials}
              linkText=""
            />
          );
      }
    })
  }

  <CTABanner
    variant="split"
    title={page.cta.title}
    titleStrong={page.cta.titleStrong}
    subtitle={page.cta.subtitle}
    ctaText={page.cta.ctaText}
    ctaHref={page.cta.ctaHref}
    secondaryCtaText={page.cta.secondaryCtaText}
    secondaryCtaHref={page.cta.secondaryCtaHref}
  />
</Layout>

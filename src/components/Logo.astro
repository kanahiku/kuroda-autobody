---
import { twMerge } from 'tailwind-merge';

/**
 * Kuroda Autobody logo — client-supplied PNGs in `public/brand/`.
 *
 *   layout  horizontal (632 × 253) · vertical (478 × 324)
 *   variant default = full colour, for light surfaces
 *           white   = all-white, for navy / dark surfaces
 *
 * The height is set by `class` (default `h-11`); width follows the aspect ratio.
 */
interface Props {
  class?: string;
  variant?: 'default' | 'white';
  layout?: 'horizontal' | 'vertical';
}

const { class: className, variant = 'default', layout = 'horizontal' } = Astro.props;

const SIZES = { horizontal: [632, 253], vertical: [478, 324] } as const;
const [width, height] = SIZES[layout];
const src = `/brand/logo-${layout}-${variant === 'white' ? 'white' : 'color'}.png`;
---

<img
  src={src}
  alt="Kuroda Autobody"
  width={width}
  height={height}
  class={twMerge('h-11 w-auto object-contain', className)}
  loading="eager"
  decoding="async"
/>

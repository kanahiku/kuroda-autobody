---
/**
 * ComparisonTable — the single shared table component for the entire site.
 *
 * Visual design (same hairline language as PhaseTable):
 *  • Accent eyebrow column headers over a top hairline
 *  • Display-font row labels, body-copy cells, hairline row dividers
 *  • Scrolls horizontally when the columns don't fit
 *
 * Used by BlogArticleBody for Sanity table blocks.
 */

export interface TableRow {
  /** Text shown in the first (feature/label) column. */
  feature: string;
  /** One value per data column; length must match `columns`. */
  values: string[];
}

export interface Props {
  /** Header for the row-label column. Defaults to "Feature". */
  featureLabel?: string;
  /** Headers for the data columns (1–4 supported). */
  columns: string[];
  /** Table rows. */
  rows: TableRow[];
  /** Optional caption rendered below the table. */
  caption?: string;
  /**
   * Minimum width of the scrollable table (CSS value).
   * Auto-calculated from column count when omitted.
   */
  minWidth?: string;
}

const { featureLabel = 'Feature', columns, rows, caption, minWidth } = Astro.props;

const autoMinWidth = columns.length <= 1 ? '380px' : columns.length === 2 ? '560px' : '680px';
const tableMinWidth = minWidth ?? autoMinWidth;

/** Strip bullet characters and collapse line-breaks so cell text is always inline. */
const cleanCell = (value?: string) =>
  String(value ?? '')
    .replace(/\s*[•·]\s*/g, ', ')
    .replace(/\s*[\r\n]+\s*(?:[-*]\s*)?/g, '; ')
    .replace(/\s{2,}/g, ' ')
    .replace(/,\s*;/g, ';')
    .trim();
---

<div class="overflow-x-auto">
  <table class="w-full border-collapse text-left" style={`min-width: ${tableMinWidth}`}>
    <thead>
      <tr class="border-t border-default-50">
        <th
          scope="col"
          class="w-[28%] py-4 pr-6 font-body text-[11px] font-bold leading-none tracking-[1.54px] text-accent uppercase"
        >
          {featureLabel}
        </th>
        {
          columns.map((col) => (
            <th
              scope="col"
              class="px-6 py-4 font-body text-[11px] font-bold leading-none tracking-[1.54px] text-accent uppercase"
            >
              {col}
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        rows.map(({ feature, values }) => (
          <tr class="border-t border-default-50 last:border-b">
            <th
              scope="row"
              class="py-5 pr-6 text-left align-top font-display text-[16px] font-semibold leading-[1.3] tracking-[-0.01em] text-heading-full"
            >
              {cleanCell(feature)}
            </th>
            {values.map((val) => (
              <td class="px-6 py-5 align-top font-body text-[15px] leading-[25px] text-body-80">{cleanCell(val)}</td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
  {caption && <p class="mt-3 font-body text-[13px] leading-[1.6] text-body-55">{caption}</p>}
</div>

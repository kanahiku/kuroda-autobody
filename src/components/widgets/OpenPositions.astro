---
import MaxWidthContainer from '~/components/ui/MaxWidthContainer.astro';
import SectionTitle from '~/components/ui/SectionTitle.astro';
import Eyebrow from '~/components/ui/Eyebrow.astro';
import type { JobOpening } from '~/lib/content';
/**
 * OpenPositions — the roles posted in Sanity (`jobOpening`), full container width under the heading.
 * Each row: title, "Full time · Place" line, short description, a "Full job description" accordion
 * (the long JD, plain <details>, no JS) and an "Apply Now" button. Renders nothing when there are no openings.
 * The button links to the application form (#apply); src/scripts/careers-form.ts then smooth-scrolls there
 * and pre-selects this position in the form's Position dropdown (via `data-apply-position`).
 */
export interface Props {
  openings: JobOpening[];
  eyebrow?: string;
  headingLead?: string;
  headingStrong?: string;
  applyLabel?: string;
  /** Label of the accordion that holds the full job description. */
  detailsLabel?: string;
  /** id of the form section the button scrolls to. */
  formId?: string;
  surface?: 'page' | 'subtle';
}

const {
  openings,
  eyebrow,
  headingLead = 'Open ',
  headingStrong = 'Positions',
  applyLabel = 'Apply Now',
  detailsLabel = 'Full job description',
  formId = 'apply',
  surface = 'page',
} = Astro.props;

type Block = { kind: 'p'; text: string } | { kind: 'h'; text: string } | { kind: 'ul'; items: string[] };

const BULLET = /^[-•*]\s+/;
/** A short line with no closing punctuation reads as a sub-heading ("Responsibilities"). */
const isHeading = (line: string) => line.length <= 50 && !/[.!?,:;]$/.test(line);

/** Plain text → blocks: each line is a paragraph, consecutive "- " lines form one bullet list. */
function toBlocks(text?: string, withHeadings = false): Block[] {
  const blocks: Block[] = [];
  for (const raw of (text ?? '').split('\n')) {
    const line = raw.trim();
    if (!line) continue;
    const last = blocks[blocks.length - 1];
    if (BULLET.test(line)) {
      const item = line.replace(BULLET, '');
      if (last?.kind === 'ul') last.items.push(item);
      else blocks.push({ kind: 'ul', items: [item] });
    } else {
      blocks.push({ kind: withHeadings && isHeading(line) ? 'h' : 'p', text: line });
    }
  }
  return blocks;
}
---

{
  openings.length > 0 && (
    <section class:list={['w-full', surface === 'subtle' ? 'bg-surface-subtle' : 'bg-surface-page']}>
      <MaxWidthContainer class="flex flex-col gap-7 py-14 md:gap-10 md:py-16 xl:py-[96px]">
        <div class="flex flex-col gap-1">
          {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
          <SectionTitle lead={headingLead} strong={headingStrong} class={eyebrow ? 'pt-3 md:pt-4' : undefined} />
        </div>

        <ul class="flex flex-col border-b border-default-50">
          {openings.map((job) => (
            <li class="flex flex-col gap-3 border-t border-default-50 py-7 md:py-8">
              <h3 class="font-display text-[22px] font-semibold leading-snug text-heading-full md:text-[26px]">
                {job.title}
              </h3>
              {job.summary && (
                <p class="font-body text-[12px] font-bold uppercase leading-4 tracking-[1.2px] text-accent">
                  {job.summary}
                </p>
              )}
              {toBlocks(job.description).map(
                (block) =>
                  block.kind === 'p' && <p class="font-body text-[16px] leading-[1.6] text-body-78">{block.text}</p>
              )}

              {job.fullDescription && (
                <details class="group mt-2 border border-default-35 rounded-[4px] bg-surface-subtle">
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-body text-[14px] font-bold uppercase tracking-[0.08em] text-heading-full [&::-webkit-details-marker]:hidden">
                    {detailsLabel}
                    <svg
                      class="size-4 shrink-0 text-accent transition-transform group-open:rotate-180"
                      viewBox="0 0 16 16"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"
                    >
                      <path d="M3 6l5 5 5-5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </summary>
                  <div class="flex flex-col gap-4 border-t border-default-35 px-5 py-5 font-body text-[16px] leading-[1.65] text-body-78">
                    {toBlocks(job.fullDescription, true).map((block) =>
                      block.kind === 'ul' ? (
                        <ul class="ml-5 list-disc space-y-1.5 marker:text-accent">
                          {block.items.map((item) => (
                            <li>{item}</li>
                          ))}
                        </ul>
                      ) : block.kind === 'h' ? (
                        <h4 class="mt-2 font-display text-[18px] font-semibold text-heading-full first:mt-0">
                          {block.text}
                        </h4>
                      ) : (
                        <p>{block.text}</p>
                      )
                    )}
                  </div>
                </details>
              )}

              <div class="mt-3">
                <a href={`#${formId}`} data-apply-position={job.title} class="btn-primary">
                  {applyLabel}
                </a>
              </div>
            </li>
          ))}
        </ul>
      </MaxWidthContainer>
    </section>
  )
}

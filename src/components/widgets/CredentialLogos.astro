---
/**
 * CredentialLogos — Figma node 136:534 ("OEM Certifications")
 * White section: head (eyebrow, two-weight heading, lede | underline text link)
 * above a 6-up row of credential tiles (logo, name, descriptor) with hairline
 * dividers. Mobile: 2-column grid.
 *
 * Logos: client PNGs in public/oem/ — one file per logo (desktop export), shown
 * at half height on mobile. A credential without a `logo` shows a grey placeholder until the
 * client supplies the file (see images.mdc). `paragraphs` replaces `lede` for multi-paragraph copy,
 * and `descriptor` is optional.
 */
import Button from '~/components/ui/Button.astro';
import MaxWidthContainer from '~/components/ui/MaxWidthContainer.astro';

export interface Credential {
  name: string;
  descriptor?: string;
  /** Logo PNG in /public (141 × 110 canvas; I-CAR is 220 × 110). Omit for a grey placeholder. */
  logo?: string;
  logoW?: number;
  logoH?: number;
}

export interface Props {
  eyebrow?: string;
  headingLead?: string;
  headingStrong?: string;
  lede?: string;
  /** Multi-paragraph copy under the heading; replaces `lede`. */
  paragraphs?: string[];
  /** Background surface (default page / white). */
  surface?: 'page' | 'subtle';
  linkText?: string;
  linkHref?: string;
  credentials?: Credential[];
}

const {
  eyebrow = 'Precision OEM specifications',
  headingLead = 'Certified for ',
  headingStrong = 'your vehicle.',
  lede = 'Manufacturer-approved procedures, tooling and genuine parts.',
  linkText = 'View all certifications',
  linkHref = '/oem-certifications/',
  paragraphs,
  surface = 'page',
  credentials = [
    {
      name: 'I-CAR Gold Class',
      descriptor: 'Highest level of industry training',
      logo: '/oem/icar-gold-class.png',
      logoW: 220,
      logoH: 110,
    },
    { name: 'Honda', descriptor: 'Genuine collision certified', logo: '/oem/honda.png', logoW: 141, logoH: 110 },
    { name: 'Acura', descriptor: 'Precision collision care', logo: '/oem/acura.png', logoW: 141, logoH: 110 },
    { name: 'Nissan', descriptor: 'Collision repair network', logo: '/oem/nissan.png', logoW: 141, logoH: 110 },
    { name: 'General Motors', descriptor: 'Chevrolet, GMC, Cadillac', logo: '/oem/gm.png', logoW: 141, logoH: 110 },
    { name: 'FCA US', descriptor: 'Chrysler, Jeep, Ram, Dodge', logo: '/oem/fca.png', logoW: 141, logoH: 110 },
  ],
} = Astro.props;
---

<section class:list={['w-full', surface === 'subtle' ? 'bg-surface-subtle' : 'bg-surface-page']}>
  <MaxWidthContainer class="flex flex-col gap-7 py-14 md:gap-14 md:py-16 xl:py-[120px]">
    {/* ── Head ── */}
    <div class="flex flex-col md:flex-row md:items-end md:justify-between md:gap-6">
      <div class="flex min-w-0 flex-col gap-1">
        <p
          class="flex items-center gap-[10px] font-body text-[11px] font-bold leading-none tracking-[1.54px] text-accent uppercase"
        >
          <span class="eyebrow-rule" aria-hidden="true"></span>
          {eyebrow}
        </p>
        <h2
          class="pt-3 font-display text-[34px] font-light leading-[1.12] tracking-[-0.02em] text-heading-full md:pt-4 md:text-[48px] md:leading-[58px]"
        >
          {headingLead}<span class="font-semibold">{headingStrong}</span>
        </h2>
        {
          (paragraphs ?? [lede]).map((text, i) => (
            <p
              class:list={[
                'font-body text-[15px] leading-[1.5] text-body-80 md:text-[16px] md:leading-[27px]',
                i === 0 ? 'mt-7 md:mt-5' : 'mt-4',
              ]}
            >
              {text}
            </p>
          ))
        }
      </div>
      {
        linkText && linkHref && (
          <Button variant="underline" text={linkText} href={linkHref} class="hidden shrink-0 md:inline-flex" />
        )
      }
    </div>

    {/* ── Credential tiles ── */}
    <ul class="grid grid-cols-2 lg:grid-cols-6">
      {
        credentials.map((c, i) => (
          <li
            class:list={[
              'flex flex-col gap-1.5 border-t border-default-50 py-5 pr-4 md:gap-[10px] md:py-7 lg:border-t-0',
              // Mobile (2-col): divider before every right-hand tile
              i % 2 === 1 && 'border-l border-default-50 pl-4',
              // Desktop (6-up): divider + 24px inset on every tile but the first
              i === 0 ? 'lg:border-l-0 lg:pl-0' : 'lg:border-l lg:border-default-50 lg:pl-6',
            ]}
          >
            {/* Logo slot — 56px tall on mobile, 110px from md; glyph left-aligned */}
            <div class="flex h-14 items-center md:h-[110px]">
              {c.logo ? (
                <img
                  src={c.logo}
                  alt={`${c.name} logo`}
                  width={c.logoW}
                  height={c.logoH}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-auto max-w-full object-contain object-left"
                />
              ) : (
                /* TODO: replace with the client's logo file when delivered */
                <div
                  class="h-full w-[88px] rounded-[4px] bg-section-grey md:w-[141px]"
                  role="img"
                  aria-label={`${c.name} logo`}
                />
              )}
            </div>
            <h3 class="font-display text-[14px] font-medium leading-[normal] text-heading-full md:text-[15px] md:leading-none">
              {c.name}
            </h3>
            {c.descriptor && (
              <p class="font-body text-[11.5px] leading-[normal] text-body-78 md:text-[12px] md:leading-[1.2]">
                {c.descriptor}
              </p>
            )}
          </li>
        ))
      }
    </ul>

    {/* Link sits below the grid on mobile (Figma 170:559); in the head on desktop */}
    {
      linkText && linkHref && (
        <Button variant="underline" text={linkText} href={linkHref} class="self-start md:hidden" />
      )
    }
  </MaxWidthContainer>
</section>

---
import Image from '~/components/common/Image.astro';
import MaxWidthContainer from '~/components/ui/MaxWidthContainer.astro';
import BrandIcon from '~/components/ui/BrandIcon.astro';
import { CONTACT } from '~/config/contact';
import { isScheduleEstimateCta, PRIMARY_CTA_HREF, SCHEDULE_CTA_HREF } from '~/config/cta';
/**
 * HomeHero — Figma node 136:217 ("Hero")
 * Navy hero: eyebrow, two-weight H1 (normal lead + gradient accent), tagline, lead body, two buttons,
 * and a 4-item credentials bar. Photo (right) is a grey placeholder until the client delivers it.
 *
 * Different DOM from `PageHero` (full-bleed photo with fades + trust bar), so it is its own widget.
 * All copy comes from props (Sanity `homePage.hero`); button destinations come from `~/config`.
 */
export interface TrustItem {
  icon: 'icar' | 'target' | 'shield' | 'home';
  text: string;
}

export interface Props {
  eyebrow: string;
  headingLead: string;
  headingAccent: string;
  tagline: string;
  body: string;
  primaryCtaText: string;
  /** Phone number is appended from CONTACT: "CALL KURODA (808) …". */
  callLabel: string;
  /** Accessible description of the hero photo (used for the grey placeholder until one is uploaded). */
  imageAlt: string;
  /** Hero photo uploaded in Sanity; absent → grey placeholder. */
  image?: { src: string; alt: string };
  trustItems: TrustItem[];
  /** Silent loop (Sanity `siteVideos`) played behind the blue tint; absent → the photo / grey placeholder only. */
  video?: { src: string; poster?: string };
}

const {
  eyebrow,
  headingLead,
  headingAccent,
  tagline,
  body,
  primaryCtaText,
  callLabel,
  imageAlt,
  image,
  trustItems,
  video,
} = Astro.props;

const trustIcon = { target: 'target-24', shield: 'shield-24', home: 'home-24' } as const;
const schedule = isScheduleEstimateCta(primaryCtaText);
const primaryHref = schedule ? SCHEDULE_CTA_HREF : PRIMARY_CTA_HREF;
---

<section
  data-home-hero
  class="relative w-full overflow-hidden bg-surface-inverse min-h-[calc(100svh-var(--hero-offset,100px))] md:h-[max(560px,calc(100svh-var(--hero-offset,135px)))] md:min-h-0"
>
  {/* Photo — right side, starts ~200px from left on desktop; grey placeholder until one is uploaded in Sanity */}
  <div
    class="absolute inset-x-0 top-0 h-[clamp(200px,34svh,460px)] overflow-hidden bg-section-grey md:inset-y-0 md:left-[200px] md:right-0 md:h-auto"
    role={image ? undefined : 'img'}
    aria-label={image ? undefined : imageAlt}
  >
    {
      image && (
        <Image
          src={image.src}
          alt={image.alt || imageAlt}
          width={1240}
          height={776}
          widths={[640, 960, 1240, 1600, 2000]}
          sizes="100vw"
          layout="cover"
          quality={75}
          class="absolute inset-0 h-full w-full object-cover"
          loading="eager"
          fetchpriority="high"
        />
      )
    }
    {
      video && (
        <>
          {/* Muted looping clip — no controls, no sound; hidden when the visitor prefers reduced motion (poster / photo shows). */}
          <video
            class="absolute inset-0 h-full w-full object-cover motion-reduce:hidden"
            src={video.src}
            poster={video.poster}
            autoplay
            muted
            loop
            playsinline
            preload="auto"
            disablepictureinpicture
            aria-hidden="true"
            tabindex="-1"
          />
        </>
      )
    }
  </div>

  {/* Gradient overlays (Figma node 136:219–221) */}
  <div
    class="absolute inset-x-0 top-0 z-[1] h-[clamp(210px,35svh,470px)] bg-hero-fade-mobile md:hidden"
    aria-hidden="true"
  >
  </div>
  <div class="absolute inset-0 z-[1] hidden bg-hero-fade-left md:block" aria-hidden="true"></div>
  <div class="absolute inset-0 z-[1] hidden bg-hero-fade-bottom md:block" aria-hidden="true"></div>
  <div class="absolute inset-0 z-[1] hidden bg-hero-fade-top md:block" aria-hidden="true"></div>

  {/* Main content layout */}
  <MaxWidthContainer class="relative z-[2] flex flex-col md:h-full">
    {/* Copy column — Figma: pt-96, pb-72 */}
    <div
      class="flex flex-1 flex-col pb-[clamp(16px,3svh,32px)] pt-[clamp(120px,24svh,300px)] md:justify-center md:py-[clamp(16px,3vh,72px)]"
    >
      {/* Eyebrow — Small / Dark (Figma: 10.5px Lato Bold, 1.26px tracking) */}
      <div class="flex items-center gap-2">
        <span class="block h-[2px] w-[16px] shrink-0 rounded-[1px] bg-gradient-brand" aria-hidden="true"></span>
        <p class="font-body text-[10.5px] font-bold uppercase leading-[13px] tracking-[1.26px] text-on-dark">
          {eyebrow}
        </p>
      </div>

      {/* 40px spacer */}
      <div class="h-[clamp(8px,1.6svh,16px)] md:h-[clamp(12px,3vh,40px)]" aria-hidden="true"></div>

      {/* H1 — Unbounded Light 64px + SemiBold sky-gradient span */}
      <h1
        class="font-display font-light text-[clamp(26px,4.8svh,38px)] leading-[1.08] tracking-[-0.03em] md:w-[709px] md:text-[clamp(40px,7vh,64px)] md:leading-[1.16]"
      >
        <span class="text-on-dark">{headingLead.trim()} </span><span class="text-gradient-hero-headline font-semibold"
          >{headingAccent}</span
        >
      </h1>

      {/* 28px spacer */}
      <div class="h-[clamp(8px,1.8svh,20px)] md:h-[clamp(10px,2.4vh,28px)]" aria-hidden="true"></div>

      {/* Tagline — Unbounded Regular 14px, sky accent */}
      <p
        class="font-display font-normal text-[12px] uppercase leading-[normal] tracking-[0.08em] text-on-dark-accent md:text-[14px] md:leading-none"
      >
        {tagline}
      </p>

      {/* 20px spacer */}
      <div class="h-[clamp(6px,1.2svh,12px)] md:h-[clamp(8px,1.8vh,20px)]" aria-hidden="true"></div>

      {/* Lead body — Lato Regular 18px, leading 30px */}
      <p
        class="max-w-[540px] font-body text-[clamp(14px,1.9svh,16px)] leading-[1.5] text-on-dark-82 md:text-[18px] md:leading-[30px]"
      >
        {body}
      </p>

      {/* 40px spacer */}
      <div class="h-[clamp(12px,2.4svh,28px)] md:h-[clamp(14px,3vh,40px)]" aria-hidden="true"></div>

      {/* Buttons — gap-12 */}
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
        <a href={primaryHref} class="btn-primary" {...schedule ? { target: '_blank', rel: 'noopener noreferrer' } : {}}>
          {primaryCtaText}
        </a>
        <a href={CONTACT.phone.href} class="btn-secondary">
          {callLabel}{' '}{CONTACT.phone.display}
        </a>
      </div>
    </div>

    {/* ── Credentials bar (Figma node 136:242) — border-t, pt-28, pb-72 ── */}
    <div
      class="border-t border-on-dark-18 pb-[clamp(16px,3svh,40px)] pt-[clamp(12px,2.4svh,24px)] md:py-[clamp(14px,2.6vh,28px)] md:pb-[clamp(20px,4vh,72px)]"
    >
      <div class="grid grid-cols-2 gap-x-0 gap-y-[clamp(8px,1.6svh,16px)] lg:flex lg:gap-0">
        {
          trustItems.map((item) => (
            <div class="flex items-center gap-[10px] lg:flex-1 lg:gap-3">
              {item.icon === 'icar' ? (
                <img
                  src="/oem/icar-gold-class-inline.png"
                  alt=""
                  aria-hidden="true"
                  width="58"
                  height="30"
                  class="h-[30px] w-[58px] shrink-0"
                />
              ) : (
                <BrandIcon name={trustIcon[item.icon]} />
              )}
              <p class="font-body text-[12.5px] font-medium leading-[normal] text-on-dark md:text-[14px] md:leading-none">
                {item.text}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </MaxWidthContainer>
</section>

<script>
  // Offset = space above the hero (utility bar + nav), so the hero fills exactly the rest of the first fold.
  const hero = document.querySelector<HTMLElement>('[data-home-hero]');
  const setOffset = () =>
    hero?.style.setProperty('--hero-offset', `${hero.getBoundingClientRect().top + window.scrollY}px`);
  setOffset();
  window.addEventListener('resize', setOffset);
</script>

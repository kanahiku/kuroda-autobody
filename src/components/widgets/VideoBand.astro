---
import MaxWidthContainer from '~/components/ui/MaxWidthContainer.astro';
import SectionTitle from '~/components/ui/SectionTitle.astro';
import Eyebrow from '~/components/ui/Eyebrow.astro';

/**
 * VideoBand — a film the visitor chooses to play: cover image + play button; click → the video plays, always
 * silent (`muted`, and the uploaded file has no audio track), with native controls (play/pause, fullscreen).
 * Only the metadata loads before the click (`preload="metadata"`).
 * Used under the Our Story hero; the file comes from Sanity (`siteVideos.aboutFilm`).
 */
export interface Props {
  src: string;
  /** Cover image shown until the video is played. */
  poster?: string;
  eyebrow?: string;
  headingLead?: string;
  headingStrong?: string;
  /** Accessible name of the film. */
  title: string;
  surface?: 'page' | 'subtle';
}

const { src, poster, eyebrow, headingLead, headingStrong, title, surface = 'page' } = Astro.props;
---

<section class:list={['w-full', surface === 'subtle' ? 'bg-surface-subtle' : 'bg-surface-page']} data-video-band>
  <MaxWidthContainer class="flex flex-col gap-8 py-16 xl:py-[96px]">
    {
      (eyebrow || headingLead) && (
        <div class="flex flex-col gap-1">
          {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
          {headingLead && (
            <SectionTitle lead={headingLead} strong={headingStrong} class={eyebrow ? 'pt-3 md:pt-4' : undefined} />
          )}
        </div>
      )
    }

    <div
      class="relative mx-auto w-full max-w-[1120px] overflow-hidden rounded-[4px] bg-surface-inverse"
      style="aspect-ratio: 16 / 9;"
    >
      <video
        class="absolute inset-0 h-full w-full object-cover"
        src={src}
        poster={poster}
        preload="metadata"
        muted
        playsinline
        controlslist="nodownload"
        aria-label={title}
        data-film
      >
      </video>
      <button
        type="button"
        class="group absolute inset-0 flex cursor-pointer items-center justify-center bg-hero-video-tint transition-opacity hover:opacity-70 focus-visible:outline-2 focus-visible:outline-offset-[-4px] focus-visible:outline-white"
        aria-label={`Play video: ${title}`}
        data-film-play
      >
        <span
          class="flex h-[84px] w-[84px] items-center justify-center rounded-full bg-surface-accent shadow-lg transition-transform group-hover:scale-105 md:h-[104px] md:w-[104px]"
        >
          <svg viewBox="0 0 24 24" class="ml-1 h-9 w-9 fill-white md:h-11 md:w-11" aria-hidden="true" data-film-icon>
            <path d="M8 5v14l11-7z"></path>
          </svg>
          <span
            class="hidden h-9 w-9 animate-spin rounded-full border-4 border-white/40 border-t-white md:h-11 md:w-11"
            aria-hidden="true"
            data-film-spinner></span>
        </span>
      </button>
    </div>
  </MaxWidthContainer>
</section>

<script>
  // Click → the video starts (always silent: the file has no audio track and the element is muted). The big button turns into a spinner until playback really begins and never
  // blocks the native controls: if playback cannot start (slow network, autoplay policy, unsupported browser) the
  // overlay is dropped and the visitor gets the browser's own play button instead of a dead end.
  document.querySelectorAll<HTMLElement>('[data-video-band]').forEach((band) => {
    const video = band.querySelector<HTMLVideoElement>('[data-film]');
    const button = band.querySelector<HTMLButtonElement>('[data-film-play]');
    const icon = band.querySelector<HTMLElement>('[data-film-icon]');
    const spinner = band.querySelector<HTMLElement>('[data-film-spinner]');
    if (!video || !button || !icon || !spinner) return;

    let giveUp = 0;
    const setLoading = (loading: boolean) => {
      spinner.classList.toggle('hidden', !loading);
      icon.classList.toggle('hidden', loading);
      button.style.pointerEvents = loading ? 'none' : '';
    };
    const handOver = () => {
      window.clearTimeout(giveUp);
      video.controls = true;
      button.style.display = 'none';
      setLoading(false);
    };

    button.addEventListener('click', () => {
      setLoading(true);
      giveUp = window.setTimeout(handOver, 6000);
      video.play().catch(handOver);
    });
    video.addEventListener('playing', handOver);
    video.addEventListener('error', handOver);
    video.addEventListener('ended', () => {
      video.controls = false;
      button.style.display = '';
    });
  });
</script>

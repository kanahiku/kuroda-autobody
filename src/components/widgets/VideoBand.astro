---
import MaxWidthContainer from '~/components/ui/MaxWidthContainer.astro';
import SectionTitle from '~/components/ui/SectionTitle.astro';
import Eyebrow from '~/components/ui/Eyebrow.astro';

/**
 * VideoBand — a film the visitor chooses to play: cover image + play button; click → the video plays, always
 * silent (`muted`, and the uploaded file has no audio track), with native controls (play/pause, fullscreen).
 * Only the metadata loads before the click (`preload="metadata"`).
 * Used under the Our Story hero; the file comes from Sanity (`siteVideos.aboutFilm`).
 */
export interface Props {
  src: string;
  /** Cover image shown until the video is played. */
  poster?: string;
  eyebrow?: string;
  headingLead?: string;
  headingStrong?: string;
  /** Accessible name of the film. */
  title: string;
  surface?: 'page' | 'subtle';
}

const { src, poster, eyebrow, headingLead, headingStrong, title, surface = 'page' } = Astro.props;
---

<section class:list={['w-full', surface === 'subtle' ? 'bg-surface-subtle' : 'bg-surface-page']} data-video-band>
  <MaxWidthContainer class="flex flex-col gap-8 py-16 xl:py-[96px]">
    {
      (eyebrow || headingLead) && (
        <div class="flex flex-col gap-1">
          {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
          {headingLead && (
            <SectionTitle lead={headingLead} strong={headingStrong} class={eyebrow ? 'pt-3 md:pt-4' : undefined} />
          )}
        </div>
      )
    }

    <div
      class="relative mx-auto w-full max-w-[1120px] overflow-hidden rounded-[4px] bg-surface-inverse"
      style="aspect-ratio: 16 / 9;"
    >
      <video
        class="absolute inset-0 h-full w-full object-cover"
        src={src}
        poster={poster}
        preload="metadata"
        muted
        playsinline
        controlslist="nodownload"
        aria-label={title}
        data-film
      >
      </video>
      <button
        type="button"
        class="group absolute inset-0 flex cursor-pointer items-center justify-center bg-hero-video-tint transition-opacity hover:opacity-70 focus-visible:outline-2 focus-visible:outline-offset-[-4px] focus-visible:outline-white"
        aria-label={`Play video: ${title}`}
        data-film-play
      >
        <span
          class="flex h-[84px] w-[84px] items-center justify-center rounded-full bg-surface-accent shadow-lg transition-transform group-hover:scale-105 md:h-[104px] md:w-[104px]"
        >
          <svg viewBox="0 0 24 24" class="ml-1 h-9 w-9 fill-white md:h-11 md:w-11" aria-hidden="true" data-film-icon>
            <path d="M8 5v14l11-7z"></path>
          </svg>
          <span
            class="hidden h-9 w-9 animate-spin rounded-full border-4 border-white/40 border-t-white md:h-11 md:w-11"
            aria-hidden="true"
            data-film-spinner></span>
        </span>
      </button>
    </div>
  </MaxWidthContainer>
</section>

<script>
  // Click → the video starts muted. The big button turns into a spinner until playback really begins, then the native
  // controls take over (visitors can unmute there). Pausing brings the tint and play circle back. If playback cannot
  // start (slow network, autoplay policy) the overlay is dropped so the visitor gets the browser's own play button.
  // Bound on `astro:page-load` (first load and every client-side navigation): a module script runs only once per
  // document, so going to another page and back left the freshly swapped-in play button without a handler.
  const bindFilms = () =>
    document.querySelectorAll<HTMLElement>('[data-video-band]').forEach((band) => {
      const video = band.querySelector<HTMLVideoElement>('[data-film]');
      const button = band.querySelector<HTMLButtonElement>('[data-film-play]');
      const icon = band.querySelector<HTMLElement>('[data-film-icon]');
      const spinner = band.querySelector<HTMLElement>('[data-film-spinner]');
      if (!video || !button || !icon || !spinner) return;

      video.muted = true; // starts muted; visitors can unmute with the native controls. (The attribute alone is lost on ClientRouter swaps.)
      // Start buffering as the film nears the viewport so the first click plays at once (the tag itself only loads
      // metadata, which keeps the page light for visitors who never scroll here).
      const preloader = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          video.preload = 'auto';
          preloader.disconnect();
        },
        { rootMargin: '800px 0px' }
      );
      preloader.observe(band);
      let giveUp = 0;
      const setLoading = (loading: boolean) => {
        spinner.classList.toggle('hidden', !loading);
        icon.classList.toggle('hidden', loading);
        button.style.pointerEvents = loading ? 'none' : '';
      };
      const handOver = () => {
        window.clearTimeout(giveUp);
        video.controls = true;
        button.style.display = 'none';
        setLoading(false);
      };

      // Click → play. If the browser rejects it or the file is slow to arrive, retry once with a fresh load, then
      // put the overlay back (never leave the visitor on a dead 0:00 player) and say why in the console.
      const start = (attempt: number) => {
        window.clearTimeout(giveUp);
        giveUp = window.setTimeout(
          () => {
            if (!video.paused && video.readyState >= 3) return;
            if (attempt === 0) {
              video.load();
              start(1);
            } else {
              console.warn('[film] could not start — readyState', video.readyState, 'network', video.networkState);
              showOverlay();
            }
          },
          attempt === 0 ? 8000 : 15000
        );
        video.play().catch((err: unknown) => {
          console.warn('[film] play() rejected:', (err as Error)?.name, (err as Error)?.message);
          if (attempt === 0) {
            video.load();
            start(1);
          } else {
            showOverlay();
          }
        });
      };
      button.addEventListener('click', () => {
        setLoading(true);
        if (video.error) video.load();
        start(0);
      });
      video.addEventListener('playing', handOver);
      video.addEventListener('error', () => {
        console.warn('[film] media error:', video.error?.code, video.error?.message);
        showOverlay();
      });
      // Paused (or finished) → the blue tint and big play circle come back; clicking it resumes.
      let pauseTimer = 0;
      const showOverlay = () => {
        window.clearTimeout(pauseTimer);
        video.controls = false;
        button.style.display = '';
        setLoading(false);
      };
      video.addEventListener('pause', () => {
        // Brief debounce: scrubbing with the native controls can emit a transient pause.
        pauseTimer = window.setTimeout(() => {
          if (video.paused && !video.seeking) showOverlay();
        }, 150);
      });
      video.addEventListener('play', () => window.clearTimeout(pauseTimer));
      video.addEventListener('ended', showOverlay);
    });
  document.addEventListener('astro:page-load', bindFilms);
</script>

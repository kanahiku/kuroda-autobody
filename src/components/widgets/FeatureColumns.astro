---
import MaxWidthContainer from '~/components/ui/MaxWidthContainer.astro';
import BrandIcon, { type BrandIconName } from '~/components/ui/BrandIcon.astro';
import { renderInline } from '~/lib/inline';
/**
 * FeatureColumns — head + icon / title / description columns.
 * White section: head (eyebrow + two-weight heading | lede) above a hairline-ruled
 * grid of icon points (same item markup as ServiceGridSplit). No images.
 */
export interface Item {
  title: string;
  description: string;
  icon: BrandIconName;
  /** Makes the title a link (e.g. hub → child pages). */
  href?: string;
}

export interface Props {
  eyebrow?: string;
  headingLead?: string;
  headingStrong?: string;
  lead?: string;
  items: Item[];
  /** Columns from md up (default 2). */
  columns?: 2 | 3;
  /** Background surface (default page / white). */
  surface?: 'page' | 'subtle';
  /** Closing sentence under the grid; `noteLinkText` renders as an inline link before the final period. */
  note?: string;
  noteLinkText?: string;
  noteLinkHref?: string;
  id?: string;
}

const {
  eyebrow,
  headingLead = '',
  headingStrong,
  lead,
  items,
  columns = 2,
  surface = 'page',
  note,
  noteLinkText,
  noteLinkHref,
  id,
} = Astro.props;
---

<section {...id ? { id } : {}} class:list={['w-full', surface === 'subtle' ? 'bg-surface-subtle' : 'bg-surface-page']}>
  <MaxWidthContainer class="flex flex-col gap-7 py-14 md:gap-[56px] md:py-16 xl:py-[120px]">
    {/* ── Head ── */}
    <div class="flex flex-col gap-7 md:gap-8 xl:flex-row xl:items-start xl:gap-24">
      <div class="flex flex-col gap-1 xl:w-[480px] xl:shrink-0">
        {
          eyebrow && (
            <p class="flex items-center gap-[10px] font-body text-[11px] font-bold leading-none tracking-[1.54px] text-accent uppercase">
              <span class="eyebrow-rule" aria-hidden="true" />
              {eyebrow}
            </p>
          )
        }
        <h2
          class="pt-3 font-display text-[34px] font-light leading-[1.12] tracking-[-0.02em] text-heading-full md:pt-4 md:text-[48px] md:leading-[58px]"
        >
          {headingLead}{headingStrong && <span class="font-semibold">{headingStrong}</span>}
        </h2>
      </div>
      {
        lead && (
          <p
            class="min-w-0 flex-1 font-display text-[16px] font-normal leading-[1.5] tracking-[-0.01em] text-heading-full md:text-[18px] md:leading-[30px] xl:pt-[34px]"
            set:html={renderInline(lead)}
          />
        )
      }
    </div>

    {/* ── Items ── */}
    <ul
      class:list={[
        'grid grid-cols-1 gap-x-6 gap-y-0 md:gap-y-10 xl:gap-x-10',
        columns === 3 ? 'md:grid-cols-3' : 'md:grid-cols-2',
      ]}
    >
      {
        items.map((item) => (
          <li class="border-t border-default-50">
            <div class="flex items-start gap-4 py-[18px] md:pb-0 md:pt-[23px]">
              <BrandIcon name={item.icon} />
              <div class="flex flex-col gap-1 md:gap-2 md:pt-[3px]">
                <h3 class="font-body text-[15px] font-bold leading-[normal] text-heading-full md:text-[16px] md:leading-none">
                  {item.href ? (
                    <a
                      href={item.href}
                      class="inline-flex items-center gap-2 transition-colors duration-150 hover:text-accent"
                    >
                      {item.title}
                      <span aria-hidden="true" class="text-accent">
                        →
                      </span>
                    </a>
                  ) : (
                    item.title
                  )}
                </h3>
                <p
                  class="font-body text-[14px] leading-[1.5] text-body-78 md:text-[14.5px]"
                  set:html={renderInline(item.description)}
                />
              </div>
            </div>
          </li>
        ))
      }
    </ul>
    {
      note && (
        <p class="font-body text-[15px] leading-[1.55] text-body-80 md:text-[16px] md:leading-7">
          {note}
          {noteLinkText && noteLinkHref && (
            <>
              {' '}
              <a
                href={noteLinkHref}
                class="font-semibold text-heading-full underline decoration-accent decoration-[1.5px] underline-offset-4 transition-colors duration-150 hover:text-accent"
              >
                {noteLinkText}
              </a>
              .
            </>
          )}
        </p>
      )
    }
  </MaxWidthContainer>
</section>

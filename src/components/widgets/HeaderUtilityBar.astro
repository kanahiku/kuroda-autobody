---
/**
 * Slim bar above the main nav — Figma: bg-surface-subtle, px-80 py-10.
 * Left: est. year + location • address. Right: hours • Follow us + social icons (the phone is in the main nav).
 */
import MaxWidthContainer from '~/components/ui/MaxWidthContainer.astro';
import SocialLinks from '~/components/ui/SocialLinks.astro';
import { CONTACT } from '~/config/contact';
import { getActiveNotice } from '~/lib/content/notice';

const notice = await getActiveNotice();
---

{
  notice && (
    <div class="w-full bg-[image:var(--gradient-hero-headline)]" role="status">
      <MaxWidthContainer class="flex items-center justify-center gap-2 py-3 text-center md:py-4">
        <p class="font-body text-[13px] leading-5 tracking-[0.06em] text-heading md:text-[16px] md:leading-6">
          <strong class="font-bold uppercase tracking-[0.12em]">{notice.label}:</strong> {notice.message}
        </p>
      </MaxWidthContainer>
    </div>
  )
}

<div class="w-full border-b border-heading/[0.08] bg-banner">
  <MaxWidthContainer class="flex items-center justify-between py-2 md:py-[10px]">
    <div class="flex items-center gap-4">
      <span
        class="font-body text-[10px] font-bold leading-3 tracking-[0.12em] text-heading uppercase md:text-[11px] md:leading-[inherit]"
      >
        EST. {CONTACT.established} &bull; {CONTACT.locationShort}
      </span>
      <span class="hidden h-3 w-px bg-heading/20 md:block" aria-hidden="true"></span>
      <span class="hidden font-body text-[11px] tracking-[0.06em] text-body-70 uppercase md:inline">
        {CONTACT.address.street}, {CONTACT.address.city}, {CONTACT.address.state}&ensp;({CONTACT.address.landmark})
      </span>
    </div>
    <div class="flex items-center gap-4">
      <span class="hidden font-body text-[11px] tracking-[0.06em] text-body-70 uppercase md:inline">
        {CONTACT.hoursDisplay}
      </span>
      <span class="hidden h-3 w-px bg-heading/20 md:block" aria-hidden="true"></span>
      <SocialLinks tone="light" />
    </div>
  </MaxWidthContainer>
</div>

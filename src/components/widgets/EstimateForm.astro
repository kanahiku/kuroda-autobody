---
import MaxWidthContainer from '~/components/ui/MaxWidthContainer.astro';
import { CONTACT } from '~/config/contact';
import { collisionRepairPages } from '~/data/collisionRepair';
import { sitemapLabel } from '~/lib/sitemap';
import { FORM_ENDPOINT, SITE_SLUG, TURNSTILE_SITE_KEY } from '~/lib/forms';
/**
 * EstimateForm — "Request an Estimate" lead form (Name, Phone, Email, Vehicle, services, details).
 * White section (sits right under the hero): two-weight heading left, form right. Posts to the shared forms worker
 * (src/lib/forms.ts) with a Cloudflare Turnstile check; the client script below binds #contact-form.
 * Service checkboxes mirror the Collision Repair pages in the sitemap.
 */
export interface Props {
  eyebrow?: string;
  headingLead?: string;
  headingStrong?: string;
  /** Background surface (default page / white). */
  surface?: 'page' | 'subtle';
  id?: string;
}

const {
  eyebrow,
  headingLead = 'Request an ',
  headingStrong = 'Estimate',
  surface = 'page',
  id = 'estimate',
} = Astro.props;

const services = collisionRepairPages.map((page) => sitemapLabel(page.path));

const fieldClass =
  'block w-full rounded-[4px] border border-default-35 bg-surface-page px-4 py-3 font-body text-[15px] text-heading-full placeholder:text-body-55 transition-colors focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20';
const labelClass = 'mb-2 block font-body text-[13px] font-bold leading-none text-heading-full';
---

<section id={id} class:list={['w-full scroll-mt-24', surface === 'subtle' ? 'bg-surface-subtle' : 'bg-surface-page']}>
  <MaxWidthContainer
    class="flex flex-col gap-7 py-14 md:gap-10 md:py-16 xl:flex-row xl:items-start xl:gap-24 xl:py-[96px]"
  >
    {/* ── Head ── */}
    <div class="flex flex-col gap-1 xl:w-[480px] xl:shrink-0">
      {
        eyebrow && (
          <p class="flex items-center gap-[10px] font-body text-[11px] font-bold leading-none tracking-[1.54px] text-accent uppercase">
            <span class="eyebrow-rule" aria-hidden="true" />
            {eyebrow}
          </p>
        )
      }
      <h2
        class:list={[
          'font-display text-[34px] font-light leading-[1.12] tracking-[-0.02em] text-heading-full md:text-[48px] md:leading-[58px]',
          eyebrow && 'pt-3 md:pt-4',
        ]}
      >
        {headingLead}<span class="font-semibold">{headingStrong}</span>
      </h2>
    </div>

    {/* ── Form ── */}
    <form
      id="contact-form"
      data-endpoint={FORM_ENDPOINT}
      data-site={SITE_SLUG}
      data-turnstile-sitekey={TURNSTILE_SITE_KEY}
      data-phone={CONTACT.phone.display}
      class="flex min-w-0 flex-1 flex-col gap-4"
      enctype="multipart/form-data"
    >
      {/* Honeypot */}
      <input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" />

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <label for="name" class={labelClass}>Name <span class="text-accent">*</span></label>
          <input
            type="text"
            id="name"
            name="name"
            required
            autocomplete="name"
            placeholder="Your full name"
            class={fieldClass}
          />
        </div>
        <div>
          <label for="phone" class={labelClass}>Phone <span class="text-accent">*</span></label>
          <input
            type="tel"
            id="phone"
            name="phone"
            required
            autocomplete="tel"
            placeholder={CONTACT.phone.display}
            class={fieldClass}
          />
        </div>
        <div>
          <label for="email" class={labelClass}>Email <span class="text-accent">*</span></label>
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            placeholder="you@example.com"
            class={fieldClass}
          />
        </div>
        <div>
          <label for="vehicle" class={labelClass}>Vehicle <span class="text-accent">*</span></label>
          <input
            type="text"
            id="vehicle"
            name="vehicle"
            required
            placeholder="Year, make and model"
            class={fieldClass}
          />
        </div>
      </div>

      <fieldset class="flex flex-col gap-3">
        <legend class={labelClass}>
          What do you need? <span class="font-normal text-body-60">(Select all that apply)</span>
        </legend>
        <div class="grid grid-cols-1 gap-x-4 gap-y-2.5 sm:grid-cols-2">
          {
            services.map((service) => (
              <label class="flex cursor-pointer items-start gap-2.5 font-body text-[14px] leading-[1.35] text-heading-full">
                <input
                  type="checkbox"
                  name="services"
                  value={service}
                  class="mt-0.5 size-4 shrink-0 rounded-none accent-accent"
                />
                <span>{service}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div>
        <label for="message" class={labelClass}>Tell Us What Happened</label>
        <textarea
          id="message"
          name="message"
          rows={3}
          placeholder="Describe the damage and anything else we should know."
          class={fieldClass}></textarea>
      </div>

      {/* Turnstile bot check */}
      <div data-turnstile></div>

      <div>
        <button type="submit" class="btn-primary cta-lg w-full disabled:opacity-60 sm:w-auto">Request Estimate</button>
      </div>

      <p
        id="form-status"
        class="hidden text-left text-[14px] font-medium text-body-78 md:text-[15px]"
        aria-live="polite"
      >
      </p>
    </form>
  </MaxWidthContainer>
</section>

<script is:inline>
  function asText(value) {
    return typeof value === 'string' ? value.trim() : '';
  }

  function composeEstimateMessage(form, data) {
    const lines = [];

    const vehicle = asText(data.get('vehicle'));
    if (vehicle) lines.push(`Vehicle: ${vehicle}`);

    const services = data.getAll('services');
    if (services.length) lines.push(`Services Requested:\n${services.map((s) => `  • ${s}`).join('\n')}`);

    const message = asText(data.get('message'));
    if (message) lines.push(`Details:\n${message}`);

    return lines.join('\n\n') || 'Estimate request submitted';
  }

  function loadTurnstile() {
    const existing = window.turnstile;
    if (existing) return Promise.resolve(existing);

    return new Promise((resolve, reject) => {
      const ready = () => {
        const api = window.turnstile;
        if (api) resolve(api);
        else reject(new Error('Turnstile failed to load'));
      };

      const script = document.querySelector('script[data-turnstile-api]');
      if (script) {
        if (window.turnstile) {
          ready();
          return;
        }
        script.addEventListener('load', ready, { once: true });
        script.addEventListener('error', () => reject(new Error('Turnstile failed to load')), { once: true });
        return;
      }

      const next = document.createElement('script');
      next.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      next.async = true;
      next.dataset.turnstileApi = 'true';
      next.addEventListener('load', ready, { once: true });
      next.addEventListener('error', () => reject(new Error('Turnstile failed to load')), { once: true });
      document.head.appendChild(next);
    });
  }

  async function bindEstimateForm() {
    const form = document.getElementById('contact-form');
    const status = document.getElementById('form-status');

    if (!form || !status || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    const slot = form.querySelector('[data-turnstile]');
    const sitekey = form.dataset.turnstileSitekey || '';
    let widgetId = '';

    if (slot && sitekey) {
      try {
        const turnstile = await loadTurnstile();
        widgetId = turnstile.render(slot, { sitekey });
      } catch (err) {
        console.error(err);
      }
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const submitButton = form.querySelector('button[type="submit"]');
      const data = new FormData(form);

      // Honeypot check
      if (asText(data.get('website'))) return;

      const endpoint = form.dataset.endpoint;
      const site = form.dataset.site;
      const turnstile = window.turnstile;
      const turnstileToken =
        widgetId && turnstile ? turnstile.getResponse(widgetId) : asText(data.get('cf-turnstile-response'));

      if (submitButton) submitButton.disabled = true;
      status.className = 'mt-4 text-left text-[14px] md:text-[15px] font-medium text-body-78';
      status.textContent = 'Sending…';
      status.classList.remove('hidden');

      try {
        if (!endpoint || !site) throw new Error('Form is not configured');
        if (!turnstileToken) throw new Error('Spam check is required');

        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            site,
            name: asText(data.get('name')),
            email: asText(data.get('email')),
            phone: asText(data.get('phone')),
            message: composeEstimateMessage(form, data),
            website: asText(data.get('website')),
            turnstileToken,
          }),
        });

        const payload = await res.json().catch(() => null);

        if (res.ok && payload?.ok) {
          status.textContent = 'Thanks! We\u2019ll review your estimate request and be in touch soon.';
          status.className = 'mt-4 text-left text-[14px] md:text-[15px] font-medium text-heading-full';
          form.reset();
          if (widgetId && turnstile) turnstile.reset(widgetId);
        } else {
          throw new Error();
        }
      } catch {
        const phone = form.dataset.phone;
        status.textContent = phone
          ? `Something went wrong. Please try again or call ${phone}.`
          : 'Something went wrong. Please try again.';
        status.className = 'mt-4 text-left text-[14px] md:text-[15px] font-medium text-red-700';
      } finally {
        if (submitButton) submitButton.disabled = false;
        status.classList.remove('hidden');
      }
    });
  }

  // Bind now (plain page load) and again after client-side navigations; `data-bound` guards double-binding.
  bindEstimateForm();
  document.addEventListener('astro:page-load', bindEstimateForm);
</script>

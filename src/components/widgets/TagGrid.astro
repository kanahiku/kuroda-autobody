---
import SectionTitle from '~/components/ui/SectionTitle.astro';
import Eyebrow from '~/components/ui/Eyebrow.astro';
import MaxWidthContainer from '~/components/ui/MaxWidthContainer.astro';
/**
 * TagGrid — head + hairline-ruled grid of short labels (communities, areas, brands).
 * Mist-grey section: head (eyebrow + two-weight heading | lede) above a numbered
 * grid of Unbounded Light labels with top hairlines (same rhythm as the Heritage stats).
 * Items link out when `href` is set.
 */
export interface Tag {
  label: string;
  href?: string;
}

export interface Props {
  eyebrow?: string;
  headingLead?: string;
  headingStrong?: string;
  lead?: string;
  items: Tag[];
  /** Background surface (default subtle / mist grey). */
  surface?: 'subtle' | 'page';
  /** Columns from md up (default 4). */
  columns?: 3 | 4;
  id?: string;
}

const { eyebrow, headingLead = '', headingStrong, lead, items, surface = 'subtle', columns = 4, id } = Astro.props;
---

<section {...id ? { id } : {}} class:list={['w-full', surface === 'page' ? 'bg-surface-page' : 'bg-surface-subtle']}>
  <MaxWidthContainer class="flex flex-col gap-7 py-14 md:gap-[56px] md:py-16 xl:py-[120px]">
    {/* ── Head ── */}
    <div class="flex flex-col gap-7 md:gap-8 xl:flex-row xl:items-start xl:gap-24">
      <div class="flex flex-col gap-1 xl:w-[480px] xl:shrink-0">
        {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
        <SectionTitle lead={headingLead} strong={headingStrong} class="pt-3 md:pt-4" />
      </div>
      {
        lead && (
          <p class="min-w-0 flex-1 font-body text-[15px] leading-[1.55] text-body-80 md:text-[16px] md:leading-7 lg:text-[17px] xl:pt-[34px]">
            {lead}
          </p>
        )
      }
    </div>

    {/* ── Grid ── */}
    <ul
      class:list={[
        'grid gap-x-6 md:gap-x-10',
        columns === 3 ? 'grid-cols-1 sm:grid-cols-3' : 'grid-cols-2 md:grid-cols-4',
      ]}
    >
      {
        items.map((item, i) => (
          <li class="flex flex-col gap-3 border-t border-default-50 pb-8 pt-5 md:gap-4 md:pb-10 md:pt-6">
            <span
              class="font-body text-[11px] font-bold leading-none tracking-[1.54px] text-body-55"
              aria-hidden="true"
            >
              {String(i + 1).padStart(2, '0')}
            </span>
            {item.href ? (
              <a
                href={item.href}
                class="font-display text-[17px] font-light leading-[1.2] tracking-[-0.02em] text-heading-full transition-colors duration-150 hover:text-accent md:text-[22px]"
              >
                {item.label}
              </a>
            ) : (
              <p class="font-display text-[17px] font-light leading-[1.2] tracking-[-0.02em] text-heading-full md:text-[22px]">
                {item.label}
              </p>
            )}
          </li>
        ))
      }
    </ul>
  </MaxWidthContainer>
</section>

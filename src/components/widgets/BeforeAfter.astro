---
import Eyebrow from '~/components/ui/Eyebrow.astro';
import MaxWidthContainer from '~/components/ui/MaxWidthContainer.astro';
import BrandIcon from '~/components/ui/BrandIcon.astro';
import Image from '~/components/common/Image.astro';
/**
 * BeforeAfter — Figma node 136:412 ("Before & After")
 * White section: eyebrow + two-tone heading with a side paragraph, two before/after cards
 * (before | after photos side by side with tags + title), and three proof points with hairlines.
 *
 * Photos: uploaded per card in Sanity (`homePage.beforeAfter.comparisons`). No upload → grey placeholder.
 */
export interface ProofPoint {
  title: string;
  description: string;
  icon: 'document' | 'camera' | 'walk-around';
}

export interface Comparison {
  title: string;
  beforeAlt: string;
  afterAlt: string;
  beforeImage?: { src: string; alt: string };
  afterImage?: { src: string; alt: string };
}

export interface Props {
  eyebrow: string;
  headingLead: string;
  headingAccent: string;
  body: string;
  beforeLabel: string;
  afterLabel: string;
  /** One card per before / after pair (Sanity `homePage.beforeAfter.comparisons`). */
  comparisons: Comparison[];
  points: ProofPoint[];
}

const { eyebrow, headingLead, headingAccent, body, beforeLabel, afterLabel, comparisons, points } = Astro.props;
---

<section class="w-full bg-surface-page">
  <MaxWidthContainer class="flex flex-col gap-7 py-14 md:gap-10 md:py-16 xl:gap-14 xl:py-[120px]">
    {/* ── Head: eyebrow + heading (left), paragraph (right) ── */}
    <div class="flex flex-col gap-7 md:gap-6 xl:flex-row xl:items-end xl:gap-20">
      <div class="flex min-w-0 flex-1 flex-col gap-1">
        <Eyebrow>{eyebrow}</Eyebrow>
        <h2
          class="pt-3 font-display text-[30px] font-light leading-[1.12] tracking-[-0.02em] text-heading-full md:pt-4 md:text-[44px] md:leading-[54px]"
        >
          {headingLead}<span class="font-semibold">{headingAccent}</span>
        </h2>
      </div>
      <p
        class="font-body text-[15px] leading-[1.55] text-body-80 md:text-[16px] md:leading-7 xl:w-[400px] xl:shrink-0 xl:text-[17px]"
      >
        {body}
      </p>
    </div>

    {/* ── Comparison cards — each card shows its before and after photo side by side ── */}
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 md:gap-8">
      {
        comparisons.map((card) => (
          <figure class="flex flex-col gap-3">
            <div class="grid grid-cols-2 gap-1 overflow-hidden rounded-[4px]">
              {(
                [
                  { label: beforeLabel, image: card.beforeImage, alt: card.beforeAlt, after: false },
                  { label: afterLabel, image: card.afterImage, alt: card.afterAlt, after: true },
                ] as const
              ).map((side) => (
                <div
                  class="relative aspect-[3/4] bg-placeholder-on-grey md:aspect-[4/5]"
                  role={side.image ? undefined : 'img'}
                  aria-label={side.image ? undefined : side.alt}
                >
                  {side.image && (
                    <Image
                      src={side.image.src}
                      alt={side.image.alt}
                      width={1000}
                      height={1250}
                      widths={[400, 700, 1000]}
                      sizes="(min-width: 1440px) 328px, (min-width: 768px) 25vw, 50vw"
                      layout="cover"
                      class="absolute inset-0 h-full w-full object-cover"
                    />
                  )}
                  <span
                    class:list={[
                      'absolute left-3 top-3 rounded-[2px] px-3 py-[7px] font-body text-[10.5px] font-bold leading-none tracking-[1.47px] uppercase',
                      side.after ? 'bg-gradient-brand text-on-dark' : 'bg-surface-page text-heading-full',
                    ]}
                  >
                    {side.label}
                  </span>
                </div>
              ))}
            </div>
            <figcaption class="font-display text-[14px] font-semibold leading-none tracking-[0.02em] text-heading-full uppercase">
              {card.title}
            </figcaption>
          </figure>
        ))
      }
    </div>

    {/* ── Proof points ── */}
    <ul class="grid grid-cols-1 gap-0 md:grid-cols-3 md:gap-12">
      {
        points.map((p) => (
          <li class="flex flex-col gap-2 border-t border-default-50 py-4 md:gap-[14px] md:pb-0 md:pt-6">
            <div class="flex items-center gap-3">
              <BrandIcon name={p.icon} />
              <h3 class="font-display text-[14px] font-semibold leading-none tracking-[0.02em] text-heading-full uppercase">
                {p.title}
              </h3>
            </div>
            <p class="font-body text-[14px] leading-[1.5] text-body-78 md:text-[15px] md:leading-[25px]">
              {p.description}
            </p>
          </li>
        ))
      }
    </ul>
  </MaxWidthContainer>
</section>

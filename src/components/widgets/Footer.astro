---
/**
 * Site footer — Figma node 136:612.
 *
 * Layout: Kuroda Navy bg · link columns row · family row · legal bar.
 *   Brand (260px)       — logo + tagline
 *   Link columns        — one per `links` entry, built from the sitemap (src/data/navigation.ts)
 *   Visit Us            — Our Location link · address · hours · phone
 *   Family of Companies — Capitol Auto Service (full-width row)
 *   Legal bar           — copyright + utility links (Legal & Utility category)
 *
 * Props are kept backward-compatible so PageLayout.astro needs no changes.
 */
import { getHomePermalink } from '~/utils/permalinks';
import GradientBand from '~/components/ui/GradientBand.astro';
import Logo from '~/components/Logo.astro';
import { site } from '~/config/site';
import { CONTACT } from '~/config/contact';
import MaxWidthContainer from '~/components/ui/MaxWidthContainer.astro';

interface NavLink {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface NavColumn {
  title?: string;
  links: NavLink[];
}

export interface Props {
  links?: NavColumn[];
  secondaryLinks?: NavLink[];
  /** @deprecated — unused in Kuroda design; accepted for compat. */
  socialLinks?: unknown[];
  /** @deprecated — unused in Kuroda design; accepted for compat. */
  footNote?: string;
}

const { links = [], secondaryLinks = [] } = Astro.props;

const locationHref = '/location/';

/* Build address one-liner from config */
const { street, city, state, zip, landmark } = CONTACT.address;
const addressLine = `${street}, ${city}, ${state} ${zip} (${landmark})`;

/* Legal links — use secondaryLinks from nav data, else fall back to Figma copy */
const legalLinks: NavLink[] =
  secondaryLinks.length > 0
    ? secondaryLinks
    : [
        { text: 'Privacy Policy', href: '/privacy-policy/' },
        { text: 'Terms', href: '/terms/' },
        { text: 'Accessibility', href: '/accessibility/' },
      ];

const year = new Date().getFullYear();
---

{/* ── Band · Blue — Figma 152:648 · 10px gradient divider above footer ── */}
<GradientBand variant="blue" />

<footer class="not-prose w-full bg-surface-inverse text-page">
  <MaxWidthContainer class="flex flex-col gap-8 pb-8 pt-12 md:gap-16 md:pt-[88px]">
    {/* ═══ Column row ═════════════════════════════════════════════════════ */}
    <div
      class="grid grid-cols-1 gap-8 sm:grid-cols-2 md:gap-10 lg:grid-cols-[260px_repeat(4,minmax(0,1fr))] lg:gap-x-10"
    >
      {/* ── Brand ────────────────────────────────────────────────────── */}
      <div class="flex flex-col gap-4 sm:col-span-2 md:gap-7 lg:col-span-1">
        <a href={getHomePermalink()} aria-label={site.name} class="inline-flex shrink-0">
          <Logo variant="white" class="h-12 md:h-[72px]" />
        </a>
        <p class="font-body text-[14px] leading-[1.55] text-on-dark-72 md:max-w-[280px] md:leading-[23px]">
          Family-owned collision repair in Waipahu, O&#x02BB;ahu since {CONTACT.established}.
        </p>
      </div>

      {/* ── Link columns — one per category from the sitemap ─────────── */}
      {
        links.map((column) => (
          <nav
            class="order-2 flex flex-col gap-2.5 border-t border-white/[0.15] pt-5 md:order-none md:border-t-0 md:pt-0"
            aria-label={column.title}
          >
            <p class="type-eyebrow text-on-dark-55">{column.title}</p>
            <div class="hidden h-px w-full bg-white/[0.15] md:block" aria-hidden="true" />
            <div class="grid grid-cols-2 gap-y-2.5 md:flex md:flex-col md:gap-2.5">
              {column.links.map(({ text, href }) =>
                href ? (
                  <a
                    href={href}
                    class="font-body text-[14px] leading-[22px] text-on-dark-85 transition-opacity hover:text-on-dark"
                  >
                    {text}
                  </a>
                ) : (
                  <span class="font-body text-[14px] leading-[22px] text-on-dark-85">{text}</span>
                )
              )}
            </div>
          </nav>
        ))
      }

      {/* ── Visit Us ─────────────────────────────────────────────────── */}
      <div
        class="order-1 flex flex-col gap-2.5 border-t border-white/[0.15] pt-5 md:order-none md:gap-3.5 md:border-t-0 md:pt-0"
      >
        <p class="type-eyebrow text-on-dark-55">
          <span class="md:hidden">LOCATION &amp; HOURS.</span><span class="hidden md:inline">VISIT US</span>
        </p>
        <div class="hidden h-px w-full bg-white/[0.15] md:block" aria-hidden="true"></div>
        <a
          href={locationHref}
          class="hidden font-body text-[14px] font-bold leading-[22px] text-on-dark-85 transition-opacity hover:text-on-dark md:block"
        >
          Our Location
        </a>
        <p class="font-body text-[14px] leading-[1.5] text-on-dark-85 md:leading-[22px]">{addressLine}</p>
        <p class="font-body text-[14px] leading-[22px] text-on-dark-85">
          Monday &ndash; Friday: 7:00 AM &ndash; 5:00 PM
        </p>
        <a
          href={CONTACT.phone.href}
          class="font-display text-[16px] font-semibold leading-[24px] text-on-dark transition-opacity hover:opacity-80 focus-visible:underline focus-visible:outline-none"
        >
          {CONTACT.phone.display}
        </a>
      </div>
    </div>

    {/* ═══ Our Family of Companies ═══════════════════════════════════════ */}
    <div
      class="flex flex-col gap-2.5 border-t border-white/[0.15] pt-5 md:flex-row md:items-baseline md:gap-10 md:pt-8"
    >
      <p class="type-eyebrow shrink-0 text-on-dark-55">OUR FAMILY OF COMPANIES.</p>
      <p class="font-display text-[15px] font-semibold leading-[22px] text-on-dark">Capitol Auto Service</p>
      <p class="font-body text-[14px] leading-[1.5] text-on-dark-72 md:leading-[22px]">
        Comprehensive mechanical, safety checks &amp; automotive maintenance in Oahu.
      </p>
    </div>

    {/* ═══ Legal bar ══════════════════════════════════════════════════════ */}
    <div
      class="flex flex-col-reverse items-start justify-between gap-3 border-t border-white/[0.15] pt-5 sm:flex-row sm:items-center sm:gap-4 sm:border-white/[0.12] sm:pt-6"
    >
      {/* Copyright */}
      <p class="font-body text-[11.5px] leading-[normal] text-on-dark-55 sm:text-[12px] sm:leading-none">
        &copy; {year} Kuroda Auto Body, Inc. All rights reserved.
      </p>

      {/* Legal links */}
      <nav class="flex flex-wrap items-center gap-x-5 gap-y-2 md:gap-x-7" aria-label="Legal">
        {
          legalLinks.map(({ text, href }) =>
            href ? (
              <a
                href={href}
                class="font-body text-[10.5px] font-bold uppercase leading-none tracking-[1.26px] text-on-dark-70 transition-opacity hover:text-on-dark"
              >
                {text}
              </a>
            ) : (
              <span class="font-body text-[10.5px] font-bold uppercase leading-none tracking-[1.26px] text-on-dark-70">
                {text}
              </span>
            )
          )
        }
      </nav>
    </div>
  </MaxWidthContainer>
</footer>

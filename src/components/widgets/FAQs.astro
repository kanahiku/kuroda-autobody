---
/**
 * FAQs — accordion widget, Kuroda design system (same type, tokens and hairlines as the homepage).
 *
 * White section: head (eyebrow + two-weight heading + optional lede) on the left, hairline-ruled
 * native <details> accordion on the right. Surface can be swapped with `<div slot="bg">`.
 * Pass `groups` (titled categories of questions) instead of `items` for long FAQ pages; an item's
 * `callToAction` renders an outline button under its answer.
 */
import SectionTitle from '~/components/ui/SectionTitle.astro';
import Eyebrow from '~/components/ui/Eyebrow.astro';
import MaxWidthContainer from '~/components/ui/MaxWidthContainer.astro';
import Button from '~/components/ui/Button.astro';
import type { Faqs, Item } from '~/types';

export interface Props extends Faqs {
  /** Eyebrow label above the heading (falls back to `tagline`). */
  eyebrow?: string;
  /** Semibold tail of the heading; `title` is the light-weight lead. */
  titleStrong?: string;
  /** Background surface (default page / white). `<div slot="bg">` still overrides. */
  surface?: 'page' | 'subtle';
  /** Titled categories of questions; replaces `items`. */
  groups?: { title: string; items: Item[] }[];
  /** @deprecated Dark editorial mode was removed with the old design system — accepted but ignored. */
  isDark?: boolean;
}

const {
  title = '',
  titleStrong,
  subtitle = '',
  tagline = '',
  eyebrow,
  surface = 'page',
  items = [],
  groups,
  id,
  bg = await Astro.slots.render('bg'),
} = Astro.props;

const label = eyebrow ?? tagline;
const lists: { title?: string; items: Item[] }[] = groups ?? [{ items }];
const Question = groups ? 'h4' : 'h3';
---

<section
  {...id ? { id } : {}}
  class:list={['relative w-full', surface === 'subtle' ? 'bg-surface-subtle' : 'bg-surface-page']}
  aria-label="Frequently asked questions"
>
  {
    bg && (
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <Fragment set:html={bg} />
      </div>
    )
  }

  <MaxWidthContainer
    class="relative flex flex-col gap-7 py-14 md:gap-12 md:py-16 xl:flex-row xl:items-start xl:gap-24 xl:py-[120px]"
  >
    {/* ── Head ── */}
    <div class="flex flex-col xl:w-[480px] xl:shrink-0">
      <div class="flex flex-col gap-1">
        {label && <Eyebrow>{label}</Eyebrow>}
        {title && <SectionTitle lead={title} strong={titleStrong} class="pt-3 md:pt-4" />}
      </div>
      {
        subtitle && (
          <p class="mt-7 font-body text-[15px] leading-[1.55] text-body-80 md:mt-6 md:text-[16px] md:leading-7 lg:text-[17px]">
            {subtitle}
          </p>
        )
      }
    </div>

    {/* ── Accordion(s) ── */}
    <div class="flex min-w-0 flex-1 flex-col gap-10 md:gap-12">
      {
        lists.map((list, gi) => (
          <div>
            {list.title && (
              <Eyebrow as="h3" class="mb-4">
                {list.title}
              </Eyebrow>
            )}
            <div class="border-b border-default-50">
              {list.items.map(({ title: question, description, callToAction }) => (
                <details class="group border-t border-default-50" name={`faq-accordion-${gi}`}>
                  <summary class="flex cursor-pointer list-none select-none items-start justify-between gap-6 py-5 md:py-6">
                    <Question class="font-display text-[16px] font-normal leading-[1.4] tracking-[-0.01em] text-heading-full md:text-[18px] md:leading-[28px]">
                      {question}
                    </Question>
                    <span class="relative mt-[7px] block size-3 shrink-0 text-accent md:mt-[9px]" aria-hidden="true">
                      <span class="absolute left-0 top-1/2 h-[1.5px] w-full -translate-y-1/2 bg-current" />
                      <span class="absolute left-1/2 top-0 h-full w-[1.5px] -translate-x-1/2 bg-current transition-transform duration-200 group-open:scale-y-0" />
                    </span>
                  </summary>
                  <div class="pb-6 pr-9 md:pb-7">
                    <p
                      class="font-body text-[14px] leading-[1.55] text-body-78 md:text-[15px] md:leading-[25px]"
                      set:html={description}
                    />
                    {callToAction?.href && (
                      <div class="mt-5">
                        <Button
                          variant="outline"
                          size="md"
                          text={callToAction.text}
                          href={callToAction.href}
                          {...(callToAction.target ? { target: callToAction.target } : {})}
                        />
                      </div>
                    )}
                  </div>
                </details>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </MaxWidthContainer>
</section>

<style>
  details > summary::-webkit-details-marker {
    display: none;
  }
</style>

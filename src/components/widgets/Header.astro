---
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import Button from '~/components/ui/Button.astro';
import MaxWidthContainer from '~/components/ui/MaxWidthContainer.astro';
import NavList from '~/components/widgets/NavList.astro';
import MobileNavLinks from '~/components/widgets/MobileNavLinks.astro';
import HeaderUtilityBar from '~/components/widgets/HeaderUtilityBar.astro';
import HeaderEmbedded from '~/components/widgets/HeaderEmbedded.astro';

import { getHomePermalink } from '~/utils/permalinks';
import { site } from '~/config/site';
import { CONTACT } from '~/config/contact';
import type { CallToAction } from '~/types';
import type { NavLink } from '~/lib/content/types';

export interface Props {
  id?: string;
  links?: NavLink[];
  actions?: CallToAction[];
  phone?: { text: string; href: string };
  /** Main button next to the phone number (desktop bar and mobile menu). */
  cta?: { text: string; href: string };
  isSticky?: boolean;
  showToggleTheme?: boolean;
  /** Render only the glass nav bar, for use inside an overlay hero. */
  embedded?: boolean;
}

const {
  id = 'header',
  links = [],
  actions = [],
  phone,
  cta = { text: 'Schedule an Estimate', href: '/contact/' },
  isSticky = false,
  showToggleTheme = false,
  embedded = false,
} = Astro.props;

const extraActions = actions.filter(
  (action) => action.href !== phone?.href && !String(action.href ?? '').startsWith('tel:')
);

const mobilePanelClass =
  'absolute inset-x-0 top-full z-50 max-h-[min(24rem,calc(100dvh-5.5rem))] flex-col overflow-y-auto border-t border-heading/10 bg-card p-3';
---

<aw-header transition:persist={embedded ? 'hero-nav' : 'header'}>
  {
    embedded ? (
      <HeaderEmbedded {id} {links} actions={extraActions} panelClass={mobilePanelClass} />
    ) : (
      <Fragment>
        <HeaderUtilityBar />

        <header
          class:list={[{ sticky: isSticky, relative: !isSticky }, 'top-0 z-40 flex-none mx-auto w-full']}
          {...(isSticky ? { 'data-aw-sticky-header': true } : {})}
          {...(id ? { id } : {})}
        >
          {/* ── Main nav bar — Figma: bg-white, border-b, px-80 py-22 ─── */}
          <div class="w-full border-b border-heading/10 bg-page">
            <MaxWidthContainer class="relative flex items-center justify-between py-[14px] md:py-[22px]">
              {/* Mobile: logo + menu toggle */}
              <a
                class="flex shrink-0 items-center md:hidden"
                href={getHomePermalink()}
                aria-label={`${site.name} home`}
              >
                <Logo class="h-[38.4px]" />
              </a>
              <div class="flex items-center gap-2 md:hidden">
                <ToggleMenu class="flex size-[42px] flex-col items-center justify-center rounded border border-strong-25 text-heading cursor-pointer group" />
              </div>

              {/* Desktop: logo */}
              <a
                class="hidden shrink-0 items-center md:flex"
                href={getHomePermalink()}
                aria-label={`${site.name} home`}
              >
                <Logo class="h-[52px]" />
              </a>

              {/* Desktop: nav links — Figma: gap-24 */}
              <nav class="hidden md:block" data-desktop-nav aria-label="Main navigation">
                <NavList links={links} class="flex items-center gap-6" />
              </nav>

              {/* Desktop: phone text + CTA — Figma: gap-18 */}
              <div class="hidden items-center gap-[18px] md:flex">
                <a
                  href={CONTACT.phone.href}
                  class="font-body font-bold text-[13px] leading-none tracking-[0.026em] text-heading transition-colors hover:text-accent"
                  aria-label={`Call ${CONTACT.phone.display}`}
                >
                  {CONTACT.phone.display}
                </a>
                {showToggleTheme && <ToggleTheme iconClass="w-5 h-5" />}
                <Button variant="primary" size="sm" href={cta.href} text={cta.text} />
              </div>
            </MaxWidthContainer>

            <div class={mobilePanelClass} data-mobile-panel>
              <MobileNavLinks links={links} />
              <div class="mt-2 flex flex-col gap-2 border-t border-heading/10 pt-3">
                <a
                  href={CONTACT.phone.href}
                  class="flex w-full items-center justify-center gap-2 font-body font-bold text-[14px] tracking-[0.04em] text-heading uppercase py-3"
                >
                  {CONTACT.phone.display}
                </a>
                <Button variant="primary" size="sm" href={cta.href} text={cta.text} class="w-full justify-center" />
              </div>
            </div>
          </div>
        </header>
      </Fragment>
    )
  }
</aw-header>

<style>
  aw-header {
    display: contents;
  }

  [data-mobile-panel] {
    display: none;
  }

  @media (max-width: 767px) {
    #header.expanded [data-mobile-panel] {
      display: flex;
    }

    [data-aw-toggle-dropdown][aria-expanded='true'] :global(svg) {
      transform: rotate(180deg);
    }
  }

  @media (min-width: 768px) {
    .mega-menu-columns {
      grid-template-columns: repeat(var(--mega-columns), minmax(0, 1fr));
    }

    li.mega .mega-menu {
      transform: translateX(calc(-50% + var(--mega-shift, 0px)));
    }

    /* Desktop chevron follows hover / keyboard focus, never click-to-toggle. */
    li.dropdown:hover > div > a :global(svg),
    li.dropdown:hover > div > button :global(svg),
    li.dropdown:has(:focus-visible) > div > a :global(svg),
    li.dropdown:has(:focus-visible) > div > button :global(svg) {
      transform: rotate(180deg);
    }
  }

  /**
   * Figma: Shadow/Sticky Header — 0 4px 20px rgba(8,41,108,0.10)
   * Applied when the header becomes sticky (JS adds data-aw-sticky-scrolled).
   */
  [data-aw-sticky-header].scrolled {
    box-shadow: var(--shadow-sticky-header);
    transition: box-shadow 0.2s ease;
  }
</style>

<script>
  import '~/scripts/aw-header';
</script>

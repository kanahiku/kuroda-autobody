---
/**
 * Embedded header — just the glass nav bar, for use inside an overlay hero.
 * Rendered by Header.astro when `embedded` is set (the <aw-header> wrapper and script live there).
 */
import Logo from '~/components/Logo.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import Button from '~/components/ui/Button.astro';
import NavList from '~/components/widgets/NavList.astro';
import MobileNavLinks from '~/components/widgets/MobileNavLinks.astro';
import { getHomePermalink } from '~/utils/permalinks';
import { site } from '~/config/site';
import type { CallToAction } from '~/types';
import type { NavLink } from '~/lib/content/types';

export interface Props {
  id?: string;
  links?: NavLink[];
  /** Extra buttons (already filtered: no phone / tel: duplicates). */
  actions?: CallToAction[];
  /** Classes for the slide-down mobile panel (shared with the main header). */
  panelClass: string;
}

const { id, links = [], actions: extraActions = [], panelClass: mobilePanelClass } = Astro.props;
---

<header class="relative z-40 w-full" data-nav="embedded" {...id ? { id } : {}}>
  <div
    class="flex h-14 w-full items-center justify-between box-border rounded-[var(--aw-radius-lg)] bg-nav-glass py-2 pl-4 pr-2 backdrop-blur-[15px] md:h-[77px] md:py-3 md:pl-6 md:pr-3"
  >
    <div class="flex shrink-0 items-center justify-between w-full md:w-auto">
      <a class="flex items-center shrink-0" href={getHomePermalink()} aria-label={`${site.name} home`}>
        <Logo variant="white" class="h-10 md:h-12" />
      </a>
      <ToggleMenu
        class="flex size-12 flex-col items-center justify-center rounded-lg bg-white/10 text-white cursor-pointer group md:hidden"
      />
    </div>
    <nav class="hidden md:flex items-center shrink-0 w-full md:w-auto" data-desktop-nav aria-label="Main navigation">
      <NavList links={links} class="flex flex-col md:flex-row md:items-center gap-6" />
    </nav>
    {
      extraActions.length > 0 && (
        <div class="hidden md:flex items-center shrink-0">
          {extraActions.map((btnProps) => (
            <Button {...btnProps} hideNote class="whitespace-nowrap" />
          ))}
        </div>
      )
    }
  </div>

  <div class={mobilePanelClass} data-mobile-panel>
    <MobileNavLinks links={links} accordion={false} />
    {
      extraActions.length > 0 && (
        <div class="mt-2 flex flex-col gap-2 border-t border-white/10 pt-3">
          {extraActions.map((btnProps) => (
            <Button {...btnProps} hideNote class="w-full justify-center" />
          ))}
        </div>
      )
    }
  </div>
</header>

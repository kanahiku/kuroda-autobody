---
/** BlogArticleImage — inline article figure from Sanity. Grey frame until the image loads. */
import Image from '~/components/common/Image.astro';
import type { ContentImage } from '~/lib/content/types';

export interface Props {
  image?: ContentImage;
  caption?: string;
  eager?: boolean;
  class?: string;
}

const { image, caption, eager = false, class: className = 'my-8 md:my-10' } = Astro.props;
const resolvedAlt = image?.alt?.trim() || caption?.trim() || 'Article image';
---

{
  image?.src && (
    <figure class={className}>
      <div class="relative aspect-[16/9] w-full overflow-hidden bg-section-grey">
        <Image
          src={image.src}
          alt={resolvedAlt}
          class="h-full w-full object-cover"
          widths={[400, 768, 1200]}
          sizes="(max-width: 768px) 100vw, 70vw"
          width={1200}
          height={675}
          layout="cover"
          format="webp"
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : 'auto'}
          decoding="async"
        />
      </div>
      {caption && (
        <figcaption class="mt-3 font-body text-[13px] leading-[1.6] text-body-55 md:text-[14px]">{caption}</figcaption>
      )}
    </figure>
  )
}

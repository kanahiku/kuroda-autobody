---
/**
 * BlogSidebar — "On this page" table of contents (with scroll-spy), tags and a CTA card.
 * variant="sticky" is the desktop rail; variant="inline" is the collapsible mobile TOC above the article.
 */
import type { TocItem } from '~/lib/content/blogArticle';
import { CONTACT } from '~/config/contact';
import { PRIMARY_CTA_HREF, SCHEDULE_CTA_LABEL } from '~/config/cta';

export interface Props {
  toc: TocItem[];
  /** Keyword tags displayed as chips (sticky only). */
  tags?: string[];
  variant?: 'sticky' | 'inline';
}

const { toc, tags, variant = 'sticky' } = Astro.props;
const isSticky = variant === 'sticky';

const eyebrow = 'font-body text-[11px] font-bold leading-none tracking-[1.54px] text-accent uppercase';
const tocLink =
  'block border-l-2 border-transparent py-1 pl-4 font-body text-[14px] leading-[1.5] text-body-80 transition-colors hover:text-heading-full aria-[current=location]:border-accent aria-[current=location]:font-semibold aria-[current=location]:text-heading-full';
---

<blog-toc-nav
  class:list={[
    'block',
    isSticky
      ? 'hidden lg:sticky lg:top-24 lg:block lg:max-h-[calc(100vh-7rem)] lg:self-start lg:overflow-y-auto'
      : 'mb-10 border-y border-default-50 py-5 lg:hidden',
  ]}
>
  {/* ── Table of contents ── */}
  {
    toc.length > 0 && (
      <nav aria-label="On this page">
        {isSticky ? (
          <>
            <p class:list={[eyebrow, 'mb-4']}>On this page</p>
            <ol class="flex flex-col">
              {toc.map((item) => (
                <li>
                  <a href={`#${item.id}`} data-toc-link class={tocLink}>
                    {item.title}
                  </a>
                </li>
              ))}
            </ol>
          </>
        ) : (
          <details class="group">
            <summary
              class:list={[
                eyebrow,
                'flex cursor-pointer list-none items-center justify-between gap-3 [&::-webkit-details-marker]:hidden',
              ]}
            >
              On this page
              <span class="text-[18px] leading-none text-heading-full transition-transform group-open:rotate-45">
                +
              </span>
            </summary>
            <ol class="mt-4 flex flex-col">
              {toc.map((item) => (
                <li>
                  <a href={`#${item.id}`} data-toc-link class={tocLink}>
                    {item.title}
                  </a>
                </li>
              ))}
            </ol>
          </details>
        )}
      </nav>
    )
  }

  {/* ── Tags ── */}
  {
    isSticky && tags && tags.length > 0 && (
      <div class:list={['mt-8', toc.length > 0 && 'border-t border-default-50 pt-8']}>
        <p class:list={[eyebrow, 'mb-3']}>Tags</p>
        <ul class="flex flex-wrap gap-2">
          {tags.map((tag) => (
            <li class="border border-default-50 px-3 py-1.5 font-body text-[12px] font-medium leading-none text-body-80">
              {tag}
            </li>
          ))}
        </ul>
      </div>
    )
  }

  {/* ── CTA card ── */}
  {
    isSticky && (
      <div class="mt-8 flex flex-col gap-4 bg-surface-inverse p-6">
        <p class="font-body text-[10.5px] font-bold uppercase leading-[13px] tracking-[1.26px] text-on-dark-accent">
          Need a repair estimate?
        </p>
        <p class="font-display text-[20px] font-light leading-[1.2] tracking-[-0.02em] text-on-dark">
          Talk to the {CONTACT.address.city} team
        </p>
        <a href={PRIMARY_CTA_HREF} class="btn-primary justify-center">
          {SCHEDULE_CTA_LABEL}
        </a>
        <a
          href={CONTACT.phone.href}
          class="font-body text-[14px] font-semibold leading-none text-on-dark-82 transition-colors hover:text-on-dark"
        >
          or call {CONTACT.phone.display}
        </a>
      </div>
    )
  }
</blog-toc-nav>

<script>
  // ── TOC scroll-spy ──────────────────────────────────────────────────────
  class BlogTocNav extends HTMLElement {
    abort?: () => void;

    connectedCallback() {
      const links = Array.from(this.querySelectorAll('a[data-toc-link]'));
      const items: { link: Element; target: HTMLElement }[] = [];

      for (const link of links) {
        const id = decodeURIComponent(link.getAttribute('href') || '').replace('#', '');
        const target = id ? document.getElementById(id) : null;
        if (target) items.push({ link, target });
      }

      if (items.length) {
        const marker = () => {
          const header = document.getElementById('header');
          const headerH = header?.getBoundingClientRect().height ?? 72;
          return Math.max(headerH + 56, 168);
        };

        const sync = () => {
          const line = marker();
          let active = items[0];
          for (const item of items) {
            if (item.target.getBoundingClientRect().top <= line) active = item;
          }
          for (const item of items) {
            if (item === active) item.link.setAttribute('aria-current', 'location');
            else item.link.removeAttribute('aria-current');
          }
        };

        sync();
        window.addEventListener('scroll', sync, { passive: true });
        window.addEventListener('resize', sync);
        window.addEventListener('hashchange', sync);
        this.abort = () => {
          window.removeEventListener('scroll', sync);
          window.removeEventListener('resize', sync);
          window.removeEventListener('hashchange', sync);
        };
      }
    }

    disconnectedCallback() {
      this.abort?.();
    }
  }

  if (!customElements.get('blog-toc-nav')) {
    customElements.define('blog-toc-nav', BlogTocNav);
  }
</script>

---
/**
 * /contact/ — location, hours, map, phone, and the estimate request form.
 * Copy lives in Sanity's `contactPage` document, merged over the built-in fallback (src/data/contact.ts) by
 * getContactContent(). The estimate form's fields stay in EstimateForm.astro; the phone, address and map
 * come from site config (`~/config/contact`).
 * Composed from shared widgets only (PageHero, EstimateForm, DetailRows with its map, ActionBand).
 * The estimate form is its own section right under the hero; the navy band's button scrolls back up to #estimate.
 */
import Layout from '~/layouts/PageLayout.astro';
import GradientBand from '~/components/ui/GradientBand.astro';
import PageHero from '~/components/widgets/PageHero.astro';
import DetailRows from '~/components/widgets/DetailRows.astro';
import ActionBand from '~/components/widgets/ActionBand.astro';
import EstimateForm from '~/components/widgets/EstimateForm.astro';
import { CONTACT } from '~/config/contact';
import { getContactContent } from '~/lib/content';

const page = await getContactContent();

const metadata = {
  title: page.seo.title,
  description: page.seo.description,
  ignoreTitleTemplate: true,
};

/** Headings are two fields (lead + accent); the lead gets its single trailing space here. */
const lead = (text: string) => `${text.trim()} `;

const ROW_LINKS = {
  none: undefined,
  directions: CONTACT.address.mapsDirectionsHref,
  phone: CONTACT.phone.href,
} as const;
---

<Layout metadata={metadata}>
  <PageHero
    eyebrow={page.hero.eyebrow}
    titleLead={lead(page.hero.headingLead)}
    titleAccent={page.hero.headingAccent}
    body={page.hero.body}
    photoLabel={page.hero.imageAlt}
    image={page.hero.image}
    showCtas={false}
  />

  <GradientBand variant="blue" />

  <EstimateForm surface="subtle" headingLead={lead(page.form.headingLead)} headingStrong={page.form.headingAccent} />

  <DetailRows
    eyebrow={page.details.eyebrow}
    headingLead={lead(page.details.headingLead)}
    headingStrong={page.details.headingAccent}
    rows={page.details.rows.map(({ link, ...row }) => ({ ...row, href: ROW_LINKS[link] }))}
    ctaText={page.details.ctaText}
    ctaHref={CONTACT.address.mapsDirectionsHref}
    ctaExternal={true}
    mapSrc={CONTACT.address.mapsEmbedSrc}
    mapTitle={page.details.mapTitle}
  />

  <ActionBand
    eyebrow={page.band.eyebrow}
    headingLead={lead(page.band.headingLead)}
    headingStrong={page.band.headingAccent}
    body={page.band.body}
    ctaText={page.band.ctaText}
    ctaHref="#estimate"
    image={page.band.image}
  />
</Layout>

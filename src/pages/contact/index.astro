---
/**
 * /contact/ — location, hours, map, phone, and the estimate request form.
 * Composed from shared widgets only (PageHero, EstimateForm, DetailRows, MapDirections, ActionBand).
 * The estimate form is its own section right under the hero; the navy band's button scrolls back up to #estimate.
 * Copy: client content doc "Auto Body & Collision Repair in Waipio".
 */
import Layout from '~/layouts/PageLayout.astro';
import GradientBand from '~/components/ui/GradientBand.astro';
import PageHero from '~/components/widgets/PageHero.astro';
import DetailRows from '~/components/widgets/DetailRows.astro';
import MapDirections from '~/components/widgets/MapDirections.astro';
import ActionBand from '~/components/widgets/ActionBand.astro';
import EstimateForm from '~/components/widgets/EstimateForm.astro';
import { CONTACT } from '~/config/contact';
import { site } from '~/config/site';

const metadata = {
  title: `Contact ${site.name} | Collision Repair in ${CONTACT.address.city}, Oʻahu`,
  description: `Visit ${site.name} in Gentry Waipio Business Park, ${CONTACT.address.city}. Call ${CONTACT.phone.display}, get directions, or request a collision repair estimate.`,
  ignoreTitleTemplate: true,
};

const mapTitle = `Map of Kuroda Auto Body, ${CONTACT.address.oneLiner}`;
---

<Layout metadata={metadata}>
  <PageHero
    eyebrow="Contact"
    titleLead="Auto Body & Collision Repair "
    titleAccent="in Waipio"
    body="Kuroda Auto Body is conveniently located in Gentry Waipio Business Park, just off the freeway and easily accessible from Aiea, Pearl City, Waipahu, Mililani and communities throughout Central and West Oahu."
    photoLabel="Kuroda Auto Body, Gentry Waipio Business Park"
    showCtas={false}
  />

  <GradientBand variant="blue" />

  <EstimateForm surface="subtle" />

  <DetailRows
    eyebrow="Easy to find. Easy to get to."
    headingLead="Location & "
    headingStrong="Directions"
    rows={[
      {
        label: 'Location',
        value: `Kuroda Auto Body\nGentry Waipio Business Park\n94-518 Puahi Street\n${CONTACT.address.city}, ${CONTACT.address.state} ${CONTACT.address.zip}`,
      },
      { label: 'Monday–Friday', value: '7:00 AM–5:00 PM' },
      { label: 'Saturday–Sunday', value: 'Closed' },
      { label: 'Phone', value: CONTACT.phone.display, href: CONTACT.phone.href },
      { label: 'Fax', value: CONTACT.fax.display },
    ]}
    ctaText="Get Directions"
    ctaHref={CONTACT.address.mapsDirectionsHref}
    ctaExternal={true}
  />

  <MapDirections mapSrc={CONTACT.address.mapsEmbedSrc} mapTitle={mapTitle} />

  <ActionBand
    eyebrow="Contact"
    headingLead="Have Questions "
    headingStrong="About a Repair?"
    body="Give us a call and our team will be happy to help. Ready to bring your vehicle in?"
    ctaText="Schedule an Estimate"
    ctaHref="#estimate"
  />
</Layout>

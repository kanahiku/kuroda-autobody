---
/**
 * /location/ — Shop location, hours, map and driving directions.
 * Composed from homepage-system widgets only (PageHero, DetailRows, MapDirections,
 * FeatureColumns, TagGrid, FAQs, CTABanner).
 *
 * All copy comes from Sanity's `locationPage` document (merged over the built-in fallback in
 * src/data/location.ts) via getLocationContent(). The phone, fax, address and map come from site config
 * (`~/config/contact`); layout and section order stay in code.
 */
import Layout from '~/layouts/PageLayout.astro';
import GradientBand from '~/components/ui/GradientBand.astro';
import PageHero from '~/components/widgets/PageHero.astro';
import DetailRows from '~/components/widgets/DetailRows.astro';
import MapDirections from '~/components/widgets/MapDirections.astro';
import FeatureColumns from '~/components/widgets/FeatureColumns.astro';
import TagGrid from '~/components/widgets/TagGrid.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import { CONTACT } from '~/config/contact';
import { getLocationContent } from '~/lib/content';

const page = await getLocationContent();

const metadata = {
  title: page.seo.title,
  ignoreTitleTemplate: true,
  description: page.seo.description,
};

/** Headings are two fields (lead + accent); the lead gets its single trailing space here. */
const lead = (text: string) => `${text.trim()} `;

const ROW_LINKS = {
  none: undefined,
  directions: CONTACT.address.mapsDirectionsHref,
  phone: CONTACT.phone.href,
} as const;
---

<Layout metadata={metadata}>
  <PageHero
    eyebrow={page.hero.eyebrow}
    titleLead={lead(page.hero.headingLead)}
    titleAccent={page.hero.headingAccent}
    body={page.hero.body}
    photoLabel={page.hero.imageAlt}
  />

  <GradientBand variant="blue" />

  <DetailRows
    eyebrow={page.details.eyebrow}
    headingLead={lead(page.details.headingLead)}
    headingStrong={page.details.headingAccent}
    rows={page.details.rows.map(({ link, ...row }) => ({ ...row, href: ROW_LINKS[link] }))}
  />

  <MapDirections
    eyebrow={page.map.eyebrow}
    headingLead={lead(page.map.headingLead)}
    headingStrong={page.map.headingAccent}
    mapSrc={CONTACT.address.mapsEmbedSrc}
    mapTitle={page.map.mapTitle}
    caption={page.map.caption}
    lead={page.map.lead}
    directions={page.map.directions}
    ctaText={page.map.ctaText}
    ctaHref={CONTACT.address.mapsDirectionsHref}
  />

  <FeatureColumns
    eyebrow={page.features.eyebrow}
    headingLead={lead(page.features.headingLead)}
    headingStrong={page.features.headingAccent}
    lead={page.features.lead}
    items={page.features.items}
  />

  <TagGrid
    eyebrow={page.communities.eyebrow}
    headingLead={lead(page.communities.headingLead)}
    headingStrong={page.communities.headingAccent}
    lead={page.communities.lead}
    items={page.communities.items}
  />

  <FAQs
    eyebrow={page.faqs.eyebrow}
    title={lead(page.faqs.headingLead)}
    titleStrong={page.faqs.headingAccent}
    items={page.faqs.items.map(({ question, answer }) => ({ title: question, description: answer }))}
  />

  <CTABanner
    variant="split"
    title={lead(page.cta.headingLead)}
    titleStrong={page.cta.headingAccent}
    subtitle={page.cta.description}
    ctaText={page.cta.ctaOne.text}
    ctaHref={page.cta.ctaOne.href}
    secondaryCtaText={page.cta.ctaTwo.text}
    secondaryCtaHref={page.cta.ctaTwo.href}
  />
</Layout>

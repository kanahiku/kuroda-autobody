---
/**
 * /online-estimate/ — photo estimate (Carwise) or in-person appointment.
 * Copy: src/data/onlineEstimate.ts. Carwise links: CARWISE in src/config/contact.ts — until they are set the
 * buttons fall back to the estimate form on /contact/. Composed from shared widgets only.
 */
import Layout from '~/layouts/PageLayout.astro';
import GradientBand from '~/components/ui/GradientBand.astro';
import PageHero from '~/components/widgets/PageHero.astro';
import FeatureColumns from '~/components/widgets/FeatureColumns.astro';
import ActionBand from '~/components/widgets/ActionBand.astro';
import { CARWISE, CONTACT } from '~/config/contact';
import { onlineEstimate as copy } from '~/data/onlineEstimate';

const metadata = { title: copy.seo.title, description: copy.seo.description, ignoreTitleTemplate: true };

const FALLBACK_HREF = '/contact/#estimate';
const photoHref = CARWISE.photoEstimateUrl || FALLBACK_HREF;
const appointmentHref = CARWISE.appointmentUrl || FALLBACK_HREF;
---

<Layout metadata={metadata}>
  <PageHero
    eyebrow={copy.hero.eyebrow}
    titleLead={copy.hero.titleLead}
    titleAccent={copy.hero.titleAccent}
    body={copy.hero.body}
    photoLabel={copy.hero.photoLabel}
    showCtas={false}
  />

  <GradientBand variant="blue" />

  <FeatureColumns
    eyebrow={copy.options.eyebrow}
    headingLead={copy.options.headingLead}
    headingStrong={copy.options.headingStrong}
    columns={2}
    items={copy.options.items}
  />

  <FeatureColumns
    surface="subtle"
    eyebrow={copy.visit.eyebrow}
    headingLead={copy.visit.headingLead}
    headingStrong={copy.visit.headingStrong}
    columns={2}
    items={copy.visit.items}
  />

  <ActionBand
    eyebrow={copy.launch.eyebrow}
    headingLead={copy.launch.headingLead}
    headingStrong={copy.launch.headingStrong}
    body={copy.launch.body}
    ctaText={copy.launch.photoCtaText}
    ctaHref={photoHref}
    ctaExternal={Boolean(CARWISE.photoEstimateUrl)}
    secondaryCtaText={copy.launch.appointmentCtaText}
    secondaryCtaHref={appointmentHref}
    secondaryCtaExternal={Boolean(CARWISE.appointmentUrl)}
  >
    <p>
      {copy.launch.callLead}<a href={CONTACT.phone.href} class="font-semibold text-white underline underline-offset-4"
        >{CONTACT.phone.display}</a
      >{copy.launch.callTrail}
    </p>
  </ActionBand>
</Layout>

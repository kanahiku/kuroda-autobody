---
/**
 * /online-estimate/ — photo estimate (Carwise) or in-person appointment.
 * Copy lives in Sanity's `onlineEstimatePage` document, merged over the built-in fallback (src/data/onlineEstimate.ts) by
 * getOnlineEstimateContent(). Carwise links: CARWISE in src/config/contact.ts — until they are set the
 * buttons fall back to the estimate form on /contact/. Composed from shared widgets only.
 */
import Layout from '~/layouts/PageLayout.astro';
import GradientBand from '~/components/ui/GradientBand.astro';
import PageHero from '~/components/widgets/PageHero.astro';
import FeatureColumns from '~/components/widgets/FeatureColumns.astro';
import ActionBand from '~/components/widgets/ActionBand.astro';
import { CARWISE, CONTACT } from '~/config/contact';
import { getOnlineEstimateContent } from '~/lib/content';

const copy = await getOnlineEstimateContent();

const metadata = { title: copy.seo.title, description: copy.seo.description, ignoreTitleTemplate: true };

/** Headings are two fields (lead + accent); the lead gets its single trailing space here. */
const lead = (text: string) => `${text.trim()} `;

const FALLBACK_HREF = '/contact/#estimate';
const photoHref = CARWISE.photoEstimateUrl || FALLBACK_HREF;
const appointmentHref = CARWISE.appointmentUrl || FALLBACK_HREF;
---

<Layout metadata={metadata}>
  <PageHero
    eyebrow={copy.hero.eyebrow}
    titleLead={lead(copy.hero.headingLead)}
    titleAccent={copy.hero.headingAccent}
    body={copy.hero.body}
    photoLabel={copy.hero.imageAlt}
    image={copy.hero.image}
    showCtas={false}
  />

  <GradientBand variant="blue" />

  <FeatureColumns
    eyebrow={copy.options.eyebrow}
    headingLead={lead(copy.options.headingLead)}
    headingStrong={copy.options.headingAccent}
    columns={2}
    items={copy.options.items}
  />

  <FeatureColumns
    surface="subtle"
    eyebrow={copy.visit.eyebrow}
    headingLead={lead(copy.visit.headingLead)}
    headingStrong={copy.visit.headingAccent}
    columns={2}
    items={copy.visit.items}
  />

  <ActionBand
    eyebrow={copy.launch.eyebrow}
    headingLead={lead(copy.launch.headingLead)}
    headingStrong={copy.launch.headingAccent}
    body={copy.launch.body}
    ctaText={copy.launch.photoCtaText}
    ctaHref={photoHref}
    ctaExternal={Boolean(CARWISE.photoEstimateUrl)}
    secondaryCtaText={copy.launch.appointmentCtaText}
    secondaryCtaHref={appointmentHref}
    secondaryCtaExternal={Boolean(CARWISE.appointmentUrl)}
  >
    <p>
      {copy.launch.callLead.trim()}{' '}<a
        href={CONTACT.phone.href}
        class="font-semibold text-white underline underline-offset-4">{CONTACT.phone.display}</a
      >{' '}{copy.launch.callTrail.trim()}
    </p>
  </ActionBand>
</Layout>

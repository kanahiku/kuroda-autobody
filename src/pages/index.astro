---
/**
 * Homepage — Figma node 136:196 (Desktop · Oct 5)
 * Sections: Hero · Ratings · Services · Why Kuroda · Before/After · Heritage · Protection · Reviews · Certifications · CTA
 *
 * Every word of copy comes from Sanity's `homePage` document (merged over the built-in fallback in
 * src/data/home.ts) via getHomeContent(), which also attaches the photos uploaded in Sanity (`<section>.image`;
 * grey placeholder when none). Layout, order, icon artwork and button destinations stay in code.
 */
import Layout from '~/layouts/PageLayout.astro';
import GradientBand from '~/components/ui/GradientBand.astro';
import HomeHero from '~/components/widgets/HomeHero.astro';
import RatingsBar from '~/components/widgets/RatingsBar.astro';
import ServiceGridSplit from '~/components/widgets/ServiceGridSplit.astro';
import FeatureListSplit from '~/components/widgets/FeatureListSplit.astro';
import BeforeAfter from '~/components/widgets/BeforeAfter.astro';
import HeritageStory from '~/components/widgets/HeritageStory.astro';
import ConsumerProtection from '~/components/widgets/ConsumerProtection.astro';
import ReviewsColumns from '~/components/widgets/ReviewsColumns.astro';
import CredentialLogos from '~/components/widgets/CredentialLogos.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import { CONTACT } from '~/config/contact';
import { getHomeContent } from '~/lib/content';

const home = await getHomeContent();

const meta = { title: home.seo.title, description: home.seo.description };

/** Headings are two fields (lead + accent); the lead gets its single trailing space here. */
const lead = (text: string) => `${text.trim()} `;

/** Logo artwork (client PNGs in /public/oem) — the Studio picks one by name. */
const LOGOS = {
  'icar-gold-class': { logo: '/oem/icar-gold-class.png', logoW: 220, logoH: 110 },
  honda: { logo: '/oem/honda.png', logoW: 141, logoH: 110 },
  acura: { logo: '/oem/acura.png', logoW: 141, logoH: 110 },
  nissan: { logo: '/oem/nissan.png', logoW: 141, logoH: 110 },
  gm: { logo: '/oem/gm.png', logoW: 141, logoH: 110 },
  fca: { logo: '/oem/fca.png', logoW: 141, logoH: 110 },
} as const;
---

<Layout metadata={meta}>
  <HomeHero {...home.hero} />

  {/* ── Band · Blue — Figma 159:109 · 10px divider below hero ── */}
  <GradientBand variant="blue" />

  {/* ── Ratings bar — Figma node 136:267 ── */}
  <RatingsBar />

  {/* ── Services split — Figma node 136:322 ── */}
  <ServiceGridSplit
    eyebrow={home.services.eyebrow}
    headingLead={lead(home.services.headingLead)}
    headingAccent={home.services.headingAccent}
    caption={home.services.caption}
    figLabel={home.services.figLabel}
    imageAlt={home.services.imageAlt}
    image={home.services.image}
    items={home.services.items}
  />

  {/* ── Band · Silver — Figma 159:110 · 10px divider below services ── */}
  <GradientBand variant="silver" />

  {/* ── Why Kuroda — Figma node 136:376 ── */}
  <FeatureListSplit
    eyebrow={home.why.eyebrow}
    headingLead={lead(home.why.headingLead)}
    headingAccent={home.why.headingAccent}
    caption={home.why.caption}
    imageAlt={home.why.imageAlt}
    image={home.why.image}
    items={home.why.items}
  />

  {/* ── Before & After — Figma node 136:412 ── */}
  <BeforeAfter
    eyebrow={home.beforeAfter.eyebrow}
    headingLead={lead(home.beforeAfter.headingLead)}
    headingAccent={home.beforeAfter.headingAccent}
    body={home.beforeAfter.body}
    beforeLabel={home.beforeAfter.beforeLabel}
    afterLabel={home.beforeAfter.afterLabel}
    imageAlt={`${home.beforeAfter.beforeAlt}. ${home.beforeAfter.afterAlt}.`}
    beforeImage={home.beforeAfter.beforeImage}
    afterImage={home.beforeAfter.afterImage}
    points={home.beforeAfter.points}
  />

  {/* ── Heritage 1938 — Figma node 136:444 ── */}
  <HeritageStory
    eyebrow={home.heritage.eyebrow}
    headingLead={lead(home.heritage.headingLead)}
    headingAccent={home.heritage.headingAccent}
    body={home.heritage.body}
    quote={home.heritage.quote}
    quoteAttribution={home.heritage.quoteAttribution}
    caption={home.heritage.caption}
    photoLabel={home.heritage.imageAlt}
    image={home.heritage.image}
    stats={home.heritage.stats}
  />

  {/* ── Consumer protection — Figma node 136:475 ── */}
  <ConsumerProtection
    eyebrow={home.protection.eyebrow}
    headingLead={lead(home.protection.headingLead)}
    headingStrong={home.protection.headingAccent}
    lead={home.protection.lead}
    note={home.protection.note}
    steps={home.protection.steps.map((step, i) => ({ number: String(i + 1).padStart(2, '0'), ...step }))}
  />

  {/* ── Reviews — Figma node 136:501 · cards = the 3 featured Sanity testimonials ── */}
  <ReviewsColumns
    eyebrow={home.reviews.eyebrow}
    headingLead={lead(home.reviews.headingLead)}
    headingStrong={home.reviews.headingAccent}
    note={home.reviews.note}
    reviews={home.reviews.items}
  />

  {/* ── OEM certifications — Figma node 136:534 ── */}
  <CredentialLogos
    eyebrow={home.credentials.eyebrow}
    headingLead={lead(home.credentials.headingLead)}
    headingStrong={home.credentials.headingAccent}
    lede={home.credentials.lede}
    linkText={home.credentials.linkText}
    credentials={home.credentials.items.map(({ logo, ...item }) => ({ ...item, ...LOGOS[logo] }))}
  />

  <GradientBand variant="silver" />

  {/* ── Final CTA — Figma node 136:589 ── */}
  <CTABanner
    variant="split"
    showBand={false}
    eyebrow={home.cta.eyebrow}
    eyebrowMobile={home.cta.eyebrowMobile}
    title={lead(home.cta.headingLead)}
    titleStrong={home.cta.headingAccent}
    subtitle={home.cta.description}
    ctaText={home.cta.ctaOne.text}
    ctaHref={home.cta.ctaOne.href}
    secondaryCtaText={home.cta.ctaTwo.text}
    secondaryCtaHref={home.cta.ctaTwo.href}
    address={`${CONTACT.address.street}, ${CONTACT.address.cityLine} (${CONTACT.address.landmark})`}
    hours={home.cta.hours}
    photoLabel={home.cta.imageAlt}
    image={home.cta.image}
  />
</Layout>
